def find_hardest_samples(df, class_name, top_n=3):
    """
    BONUS CHALLENGE (Advanced):
    In machine learning, we want to locate classification errors to analyze
    potential failures and verify edge cases.
    
    Write a function that:
    1. Filters the DataFrame to only include rows where ground_truth matches class_name.
    2. Filters for samples that were misclassified (predicted_class does not match ground_truth).
    3. Returns a DataFrame with only the columns ["image_path", "predicted_class"] for the top_n samples.
    """
    # [STUDENT_STARTER]
    # TODO: Perform filtering and slicing
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    filtered_df = df[(df["ground_truth"] == class_name) & (df["predicted_class"] != class_name)]
    return filtered_df[["image_path", "predicted_class"]].head(top_n)
    # [/REFERENCE_SOLUTION]


