def select_and_filter_data(df):
    """
    1. Select columns "predicted_class" and "ground_truth".
    2. Use .loc or .iloc to select the first 10 rows of these columns.
    3. Filter the original DataFrame to rows where prediction does not match ground_truth.
       
    Returns: (selected_subset_df, filtered_errors_df)
    """
    # [STUDENT_STARTER]
    # TODO: Select columns and filter errors
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    # Column selection
    selected_cols = df[["predicted_class", "ground_truth"]]
    # first 10 rows using loc
    selected_subset = selected_cols.loc[:9]
    
    # Filter rows where predictions mismatch ground_truth
    filtered_errors = df[df["predicted_class"] != df["ground_truth"]]
    
    return selected_subset, filtered_errors
    # [/REFERENCE_SOLUTION]

def feature_engineering(df):
    """
    Creates new columns for engineered features:
    1. df["is_correct"]: boolean mapping if "predicted_class" == "ground_truth".
    2. df["error_type"]: string concatenating ground_truth and prediction.
       Format: "actual_[GT]_predicted_as_[PRED]"
       
    Returns: modified_dataframe
    """
    # [STUDENT_STARTER]
    # TODO: Perform column engineering operations
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    df = df.copy()
    df["is_correct"] = df["predicted_class"] == df["ground_truth"]
    df["error_type"] = "actual_" + df["ground_truth"].astype(str) + "_predicted_as_" + df["predicted_class"].astype(str)
    return df
    # [/REFERENCE_SOLUTION]

def sort_and_find_extremes(df):
    """
    1. Sort the DataFrame by image_path alphabetically.
    2. Identify the top 3 errors (is_correct is False).
    
    Returns: top_3_errors_df
    """
    # [STUDENT_STARTER]
    # TODO: Sort and locate top errors
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    # Ensure columns exist
    if "is_correct" not in df.columns:
        df = feature_engineering(df)
    
    sorted_df = df.sort_values(by="image_path")
    errors_df = sorted_df[sorted_df["is_correct"] == False]
    return errors_df.head(3)
    # [/REFERENCE_SOLUTION]

def group_statistics(df):
    """
    1. Group the DataFrame by ground_truth class.
    2. Calculate class prediction counts and prediction accuracy.
    
    Returns: grouped_stats_dataframe
    """
    # [STUDENT_STARTER]
    # TODO: Apply groupby statistics
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    # Ensure is_correct exists
    if "is_correct" not in df.columns:
        df = feature_engineering(df)
        
    grouped = df.groupby("ground_truth").agg(
        count=("predicted_class", "count"),
        accuracy=("is_correct", "mean")
    )
    return grouped
    # [/REFERENCE_SOLUTION]

def handle_missing_values(df):
    """
    Cleans up missing (NaN) data:
    1. Check for null values in the DataFrame.
    2. Fill NaN values in the 'image_path' column with 'unknown_image.jpg'.
    3. Drop any rows where 'predicted_class' or 'ground_truth' is missing.
    
    Returns: cleaned_dataframe
    """
    # [STUDENT_STARTER]
    # TODO: Handle NaNs
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    df = df.copy()
    
    # Fill missing image paths
    if "image_path" in df.columns:
        df["image_path"] = df["image_path"].fillna("unknown_image.jpg")
        
    # Drop rows missing class names
    df = df.dropna(subset=["predicted_class", "ground_truth"])
    return df
    # [/REFERENCE_SOLUTION]

def export_clean_data(df, output_path):
    """
