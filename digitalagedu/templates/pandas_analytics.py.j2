def explore_and_inspect_data(csv_path):
    """
    1. Loads the CSV dataset into a Pandas DataFrame.
    2. Prints inspection info using head(), tail(), info(), describe().
    
    Returns: (dataframe, shape_tuple, columns_list, head_df, tail_df)
    """
    # [STUDENT_STARTER]
    # TODO: Load and inspect DataFrame
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    df = pd.read_csv(csv_path)
    
    # Run inspection calls (prints to stdout)
    print("--- Head ---")
    print(df.head(3))
    print("--- Tail ---")
    print(df.tail(3))
    print("--- Info ---")
    df.info()
    print("--- Describe ---")
    print(df.describe())
    
    return df, df.shape, list(df.columns), df.head(3), df.tail(3)
    # [/REFERENCE_SOLUTION]

def select_and_filter_data(df, confidence_threshold=0.5):
    """
    1. Select columns "predicted_class" and "confidence".
    2. Use .loc or .iloc to select the first 10 rows of these columns.
    3. Filter the original DataFrame to rows where confidence is less than threshold,
       AND prediction does not match ground_truth (i.e. model was incorrect).
       
    Returns: (selected_subset_df, filtered_errors_df)
    """
    # [STUDENT_STARTER]
    # TODO: Select columns and filter errors
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    # Column selection
    selected_cols = df[["predicted_class", "confidence"]]
    # first 10 rows using loc
    selected_subset = selected_cols.loc[:9]
    
    # Filter rows with confidence < threshold AND predictions mismatch ground_truth
    mismatch_mask = df["predicted_class"] != df["ground_truth"]
    low_conf_mask = df["confidence"] < confidence_threshold
    filtered_errors = df[low_conf_mask & mismatch_mask]
    
    return selected_subset, filtered_errors
    # [/REFERENCE_SOLUTION]

def feature_engineering(df):
    """
    Creates new columns to engineered features:
    1. df["is_correct"]: boolean mapping if "predicted_class" == "ground_truth".
    2. df["high_confidence_error"]: boolean mapping if is_correct is False
       AND confidence is >= 0.8.
       
    Returns: modified_dataframe
    """
    # [STUDENT_STARTER]
    # TODO: Perform column engineering operations
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    df = df.copy()
    df["is_correct"] = df["predicted_class"] == df["ground_truth"]
    df["high_confidence_error"] = (df["is_correct"] == False) & (df["confidence"] >= 0.8)
    return df
    # [/REFERENCE_SOLUTION]

def sort_and_find_extremes(df):
    """
    1. Sort the DataFrame by confidence in descending order.
    2. Identify the top 3 highest confidence errors (high_confidence_error is True).
    
    Returns: top_3_errors_df
    """
    # [STUDENT_STARTER]
    # TODO: Sort and locate top errors
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    # Ensure columns exist
    if "high_confidence_error" not in df.columns:
        df = feature_engineering(df)
    
    sorted_df = df.sort_values(by="confidence", ascending=False)
    errors_df = sorted_df[sorted_df["high_confidence_error"] == True]
    return errors_df.head(3)
    # [/REFERENCE_SOLUTION]

def group_statistics(df):
    """
    1. Group the DataFrame by ground_truth class.
    2. Calculate class prediction counts and the mean confidence of predictions.
    
    Returns: grouped_stats_dataframe
    """
    # [STUDENT_STARTER]
    # TODO: Apply groupby statistics
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    grouped = df.groupby("ground_truth").agg(
        count=("predicted_class", "count"),
        mean_confidence=("confidence", "mean")
    )
    return grouped
    # [/REFERENCE_SOLUTION]

def handle_missing_values(df):
    """
    Cleans up missing (NaN) data:
    1. Check for null values in the DataFrame.
    2. Fill NaN values in the 'confidence' column with its median value.
    3. Drop any rows where 'predicted_class' or 'ground_truth' is missing.
    
    Returns: cleaned_dataframe
    """
    # [STUDENT_STARTER]
    # TODO: Handle NaNs
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    df = df.copy()
    
    # Fill confidence NaNs with median
    if "confidence" in df.columns:
        median_val = df["confidence"].median()
        df["confidence"] = df["confidence"].fillna(median_val)
        
    # Drop rows missing class names
    df = df.dropna(subset=["predicted_class", "ground_truth"])
    return df
    # [/REFERENCE_SOLUTION]

