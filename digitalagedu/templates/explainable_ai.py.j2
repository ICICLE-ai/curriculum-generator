# CONCEPTUAL SHIFT:
# - We now stop training models and start interrogating internal representations.
# - Instead of adjusting weights to minimize loss, we inspect the weights and 
#   gradients of an already trained model to understand *why* it makes a decision.
#
# THE ATTRIBUTION VS. SEGMENTATION DIFFERENCE:
# - How does a Grad-CAM heatmap differ from a Semantic Segmentation mask?
#   * Segmentation mask tells us: WHAT is present in the image (pixel-level prediction).
#   * Grad-CAM heatmap tells us: WHAT influenced the classification prediction (attribution).
# - E.g. A segmentation mask highlights a lesion's borders. Grad-CAM shows if the
#   model classified it because of the lesion itself or because of background artifact noise.
#
# THE XAI ATTRIBUTION RULE:
# - Grad-CAM does not change the model — it projects internal activations into input 
#   space for human interpretation. Model behavior remains identical.
#
# FAILURE CASES & CAUTIONS OF ATTRIBUTION:
# - Explanations are NOT guarantees of truth.
# - Grad-CAM can highlight irrelevant background pixels due to spurious correlations.
# - Gradients can saturate, yielding flat or uninformative heatmaps.
# - Attributions tell you what the model looked at, not if the model's reasoning is medically correct.
# =====================================================================

import torch
import torch.nn as nn
import numpy as np

# =====================================================================
# 1. Grad-CAM Hook Context Manager & Heatmap Generation
# =====================================================================
class GradCAMHook:
    """
    A clean Python context manager that handles registering and automatically 
    removing forward and backward PyTorch hooks to capture activations and gradients.
    """
    def __init__(self, target_layer):
        self.target_layer = target_layer
        self.activations = None
        self.gradients = None
        self.f_hook = None
        self.b_hook = None
        
    def forward_hook(self, module, input, output):
        self.activations = output.detach()
        
    def backward_hook(self, module, grad_input, grad_output):
        self.gradients = grad_output[0].detach()
        
    def __enter__(self):
        self.f_hook = self.target_layer.register_forward_hook(self.forward_hook)
        self.b_hook = self.target_layer.register_backward_hook(self.backward_hook)
        return self
        
    def __exit__(self, exc_type, exc_val, exc_tb):
        if self.f_hook:
            self.f_hook.remove()
        if self.b_hook:
            self.b_hook.remove()

def generate_gradcam(model, image_tensor, target_class_idx):
    """
    Generates a 2D Grad-CAM heatmap representing the model's visual attention
    areas for target_class_idx.
    
    Returns a numpy array of shape (H, W) normalized between 0.0 and 1.0.
    """
    # [STUDENT_STARTER]
    # TODO: Use the GradCAMHook context manager on model.conv2, run forward/backward pass,
    # average the gradients per channel, weight the activations, compute ReLU, and normalize.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    # Register hooks using the GradCAMHook context manager
    with GradCAMHook(model.conv2) as hook:
        # 1. Forward Pass
        model.zero_grad()
        output = model(image_tensor)
        
        # 2. Backward Pass for the target class score
        score = output[0, target_class_idx]
        score.backward()
        
        # Extract captured activations and gradients
        grads = hook.gradients[0] # shape (C, H_features, W_features)
        acts = hook.activations[0] # shape (C, H_features, W_features)
        
    # 3. Average the gradients across the spatial dimensions (height/width)
    weights = torch.mean(grads, dim=(1, 2), keepdim=True) # shape (C, 1, 1)
    
    # 4. Multiply each channel activation by its corresponding gradient weight
    cam = torch.sum(weights * acts, dim=0).cpu().numpy() # shape (H_features, W_features)
    
    # 5. Apply ReLU (keep only positive activations) and normalize
    cam = np.maximum(cam, 0)
    denom = cam.max() - cam.min()
    if denom > 0:
        cam = (cam - cam.min()) / denom
    else:
        cam = np.zeros_like(cam)
        
    return cam
    # [/REFERENCE_SOLUTION]

# =====================================================================
# 2. Vanilla Saliency Maps
# =====================================================================
def generate_saliency_map(model, image_tensor, target_class_idx):
    """
    Core function that generates a simple Vanilla Saliency map by computing the 
    gradient of the target class score with respect to the input image pixels.
    
    Returns: a numpy array of shape (H, W) representing pixel-wise gradient magnitudes.
    """
    # [STUDENT_STARTER]
    # TODO: Calculate gradients of output score with respect to input image
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    model.eval()
    image_tensor.requires_grad_()
    
    output = model(image_tensor)
    score = output[0, target_class_idx]
    score.backward()
    
    # Get max magnitude across channels
    saliency, _ = torch.max(image_tensor.grad.data.abs(), dim=1)
    return saliency[0].cpu().numpy()
    # [/REFERENCE_SOLUTION]

