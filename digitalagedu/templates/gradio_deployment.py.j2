def run_pipeline(model, image_numpy, classes):
    """
    Executes the classification and analysis pipeline on a raw image:
    1. Preprocesses the image_numpy to a float tensor.
    2. Runs inference through the model to get predictions.
    3. Calculates confidence probabilities.
    4. Computes target object segmentation (using segment_image_fallback).
    5. Computes visual attention maps (using generate_saliency_map).
    
    Returns: predicted_class_name, confidence_float, segmentation_overlay, saliency_map
    """
    # [STUDENT_STARTER]
    # TODO: Preprocess, classify, and call the segmentation/saliency helper functions.
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    import torchvision.transforms as transforms
    from PIL import Image
    
    img = Image.fromarray(image_numpy).convert("RGB")
    # Match dataset dimensions
    img_size = {{ image_size }}
    transform = transforms.Compose([
        transforms.Resize((img_size, img_size)),
        transforms.ToTensor()
    ])
    
    img_tensor = transform(img).unsqueeze(0) # (1, 3, H, W)
    
    # A. Classification
    model.eval()
    with torch.no_grad():
        logits = model(img_tensor)
        probs = torch.softmax(logits, dim=1)[0]
        pred_idx = torch.argmax(probs).item()
        confidence = float(probs[pred_idx].item())

        if isinstance(classes, list):
            class_list = classes
        elif isinstance(classes, dict):
            if all(isinstance(k, int) or str(k).isdigit() for k in classes.keys()):
                class_list = [classes[k] for k in sorted(classes.keys(), key=lambda x: int(x))]
            else:
                class_list = list(classes.keys())
        else:
            class_list = list(classes)

        pred_class = class_list[pred_idx] if pred_idx < len(class_list) else str(pred_idx)
        
    # B. Segmentation (using floodFill helper)
    segmentation_overlay = segment_image_fallback(image_numpy)
    
    # C. Explainable AI Attributions (requires gradients)
    saliency_map = generate_saliency_map(model, image_numpy)
    
    return pred_class, float(confidence), segmentation_overlay, saliency_map
    # [/REFERENCE_SOLUTION]

