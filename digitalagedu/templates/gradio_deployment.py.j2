def segment_image_fallback(image_numpy, tolerance=15):
    """
    Applies a center-seeded floodFill segmentation on the input image
    and returns a transparent green mask overlay.
    """
    import cv2
    h, w = image_numpy.shape[:2]
    seed_point = (w // 2, h // 2)
    
    # Padded mask for floodFill
    ff_mask = np.zeros((h + 2, w + 2), dtype=np.uint8)
    img_copy = image_numpy.copy()
    
    flags = 4 | (255 << 8) | cv2.FLOODFILL_MASK_ONLY
    cv2.floodFill(img_copy, ff_mask, seed_point, 255, loDiff=(tolerance,)*3, upDiff=(tolerance,)*3, flags=flags)
    
    mask = ff_mask[1:-1, 1:-1]
    colored_mask = np.zeros_like(image_numpy)
    colored_mask[mask > 0] = (0, 255, 0) # Green overlay
    
    alpha = 0.4
    overlay = cv2.addWeighted(image_numpy, 1.0 - alpha, colored_mask, alpha, 0)
    return overlay

def generate_saliency_map(model, image_numpy):
    """
    Performs a backward pass on the input image through the classifier model
    and extracts the pixel-wise input gradients.
    """
    import cv2
    import torchvision.transforms as transforms
    from PIL import Image
    
    img_size = {{ image_size }}
    transform = transforms.Compose([
        transforms.Resize((img_size, img_size)),
        transforms.ToTensor()
    ])
    
    img = Image.fromarray(image_numpy).convert("RGB")
    img_tensor = transform(img).unsqueeze(0)
    img_tensor.requires_grad = True
    
    model.eval()
    logits = model(img_tensor)
    
    score, pred_class = torch.max(logits, dim=1)
    score.backward()
    
    # Retrieve absolute gradients
    saliency, _ = torch.max(torch.abs(img_tensor.grad[0]), dim=0)
    saliency_np = saliency.cpu().numpy()
    
    if saliency_np.max() > 0:
        saliency_np = (saliency_np / saliency_np.max() * 255).astype(np.uint8)
    else:
        saliency_np = saliency_np.astype(np.uint8)
        
    saliency_resized = cv2.resize(saliency_np, (image_numpy.shape[1], image_numpy.shape[0]))
    saliency_rgb = cv2.cvtColor(saliency_resized, cv2.COLOR_GRAY2RGB)
    return saliency_rgb

