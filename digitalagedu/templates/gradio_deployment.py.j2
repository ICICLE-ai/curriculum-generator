import os
import torch
import torch.nn as nn
import numpy as np

# We import the classes written in previous weeks
# In production, they are available in the student directory.
# For sandbox verification, we can mock their implementations.
try:
    from cnn_optimization import RegularizedCNN
except ImportError:
    # Fallback mock for testing
    class RegularizedCNN(nn.Module):
        def __init__(self, num_classes=2, img_size=224):
            super(RegularizedCNN, self).__init__()
            self.conv1 = nn.Conv2d(3, 8, kernel_size=3, padding=1)
            self.conv2 = nn.Conv2d(8, 16, kernel_size=3, padding=1)
            self.pool = nn.AdaptiveAvgPool2d((8, 8))
            self.fc = nn.Linear(8 * 8 * 16, num_classes)
        def forward(self, x):
            x = torch.relu(self.conv1(x))
            x = torch.relu(self.conv2(x))
            x = self.pool(x)
            return self.fc(x.view(x.size(0), -1))

def load_model_weights(model_path, num_classes, img_size={{ image_size }}):
    """
    Instantiates the RegularizedCNN and loads pretrained weights
    from model_path into the state dictionary.
    
    If model_path is missing or empty, returns model with random weights.
    """
    model = RegularizedCNN(num_classes=num_classes, img_size=img_size)
    
    # [STUDENT_STARTER]
    # TODO: Load weights using torch.load. Handle missing files gracefully.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    if os.path.exists(model_path):
        try:
            state_dict = torch.load(model_path, map_location=torch.device('cpu'))
            model.load_state_dict(state_dict)
            print(f"[INFO] Successfully loaded model weights from {model_path}")
        except Exception as e:
            print(f"[ERROR] Failed loading weights: {e}. Using randomized weights.")
    else:
        print("[WARNING] Weights file not found. Initializing model with random weights.")
        
    model.eval()
    return model
    # [/REFERENCE_SOLUTION]

def run_diagnostic_pipeline(model, image_numpy, classes):
    """
    Executes the classification and analysis pipeline on a raw image:
    1. Preprocesses the image_numpy to a float tensor.
    2. Runs inference through the model to get predictions.
    3. Calculates confidence probabilities.
    
    Returns: predicted_class_name, confidence_float
    """
    # [STUDENT_STARTER]
    # TODO: Preprocess, run forward pass, calculate softmax, and return class + confidence.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    import torchvision.transforms as transforms
    from PIL import Image
    
    img = Image.fromarray(image_numpy).convert("RGB")
    # Match dataset dimensions
    img_size = {{ image_size }}
    transform = transforms.Compose([
        transforms.Resize((img_size, img_size)),
        transforms.ToTensor()
    ])
    
    img_tensor = transform(img).unsqueeze(0) # (1, 3, H, W)
    
    with torch.no_grad():
        logits = model(img_tensor)
        probs = torch.softmax(logits, dim=1)[0]
        
        pred_idx = torch.argmax(probs).item()
        confidence = probs[pred_idx].item()
        
    return classes[pred_idx], float(confidence)
    # [/REFERENCE_SOLUTION]

