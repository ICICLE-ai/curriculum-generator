if __name__ == "__main__":
    import os
    import matplotlib
    matplotlib.use('Agg')
    import matplotlib.pyplot as plt
    from PIL import Image
    
    print("==================================================")
    print("STARTING SEMANTIC SEGMENTATION & U-NET DECODER LAB")
    print("==================================================")
    
    sample_img_path = r"{{ sample_image_path }}"
    sample_mask_path = r"{{ sample_mask_path }}"
    img_size = {{ image_size }}
    
    # 1. Initialize Decoder
    decoder = MiniSegmentationDecoder(in_channels=16, hidden_channels=8, out_channels=1, img_size=img_size)
    print(f"[INFO] Initialized Mini U-Net Decoder with spatial target dimensions: {img_size}x{img_size}")
    
    # 2. Simulate Encoder Bottleneck Features
    # Input has shape (Batch, Channels, H/4, W/4)
    bottleneck_h = img_size // 4
    bottleneck_w = img_size // 4
    print(f"[INFO] Generating simulated encoder bottleneck features of shape: (1, 16, {bottleneck_h}, {bottleneck_w})")
    torch.manual_seed(42)
    bottleneck_features = torch.randn(1, 16, bottleneck_h, bottleneck_w)
    
    # Forward Pass through the decoder to get logits
    y_pred_logits = decoder(bottleneck_features)
    print(f" -> Output prediction shape (logits): {y_pred_logits.shape} [OK]")
    
    # 3. Load actual SAM target mask if available
    if os.path.exists(sample_mask_path):
        print(f"\n[INFO] Loading actual SAM pipeline target mask: {sample_mask_path}...")
        try:
            mask_img = Image.open(sample_mask_path).convert("L").resize((img_size, img_size))
            y_true_mask = torch.tensor(np.array(mask_img), dtype=torch.float32).unsqueeze(0).unsqueeze(0) / 255.0
            # Convert to strict binary values (0.0 or 1.0)
            y_true_mask = (y_true_mask > 0.5).float()
            
            # Compute Combined Loss (BCE + Soft Dice Loss)
            loss_val = combined_loss(y_pred_logits, y_true_mask)
            print(f" -> Combined Loss value (untrained): {loss_val.item():.4f}")
            
            # 4. Sigmoid Probability Scaling & Threshold Optimization
            y_pred_probs = torch.sigmoid(y_pred_logits)
            
            # Run threshold search algorithm
            best_thresh, best_dice = find_optimal_threshold(y_pred_probs[0, 0].numpy(), y_true_mask[0, 0].numpy())
            print(f" -> Optimal Segmentation Threshold:    {best_thresh:.1f}")
            print(f" -> Maximum Hard Dice Score achieved:   {best_dice*100:.2f}% (Untrained reference)")
            
            # 5. Save visual comparison plot
            if os.path.exists(sample_img_path):
                img = Image.open(sample_img_path).convert("RGB").resize((img_size, img_size))
                pred_mask = (y_pred_probs[0, 0] >= best_thresh).float().numpy()
                
                fig, axes = plt.subplots(1, 3, figsize=(12, 4))
                axes[0].imshow(img)
                axes[0].set_title("Original Image")
                axes[0].axis("off")
                
                axes[1].imshow(y_true_mask[0, 0].numpy(), cmap="gray")
                axes[1].set_title("Ground-Truth SAM Mask")
                axes[1].axis("off")
                
                axes[2].imshow(pred_mask, cmap="gray")
                axes[2].set_title(f"Predicted Decoder Mask\n(Threshold={best_thresh:.1f})")
                axes[2].axis("off")
                
                output_plot = "unet_segmentation_prediction.png"
                plt.tight_layout()
                plt.savefig(output_plot)
                plt.close()
                print(f"[SUCCESS] Saved segmentation prediction comparison curves to '{output_plot}'")
                
        except Exception as e:
            print(f"[WARNING] Error running visual inference segmenter: {e}")
