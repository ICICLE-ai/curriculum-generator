import torch
import torch.nn as nn
import numpy as np

class MiniSegmentationDecoder(nn.Module):
    """
    A miniature segmentation decoder that upsamples bottleneck features 
    back to the original image dimensions.
    - Input bottleneck features: shape (Batch, 16, H/4, W/4)
    - Output binary segmentation logits: shape (Batch, 1, H, W)
    """
    def __init__(self, in_channels=16, hidden_channels=8, out_channels=1, img_size={{ image_size }}):
        super(MiniSegmentationDecoder, self).__init__()
        self.img_size = img_size
        
        # [STUDENT_STARTER]
        # TODO: Define layers. We need to upsample twice by a factor of 2.
        # Use ConvTranspose2d (stride=2, padding=1, output_padding=1, kernel_size=4)
        # pass
        # [/STUDENT_STARTER]
        # [REFERENCE_SOLUTION]
        # First upsample: (Batch, 16, H/4, W/4) -> (Batch, 8, H/2, W/2)
        self.upsample1 = nn.ConvTranspose2d(
            in_channels, hidden_channels, 
            kernel_size=4, stride=2, padding=1
        )
        self.relu = nn.ReLU()
        
        # Second upsample: (Batch, 8, H/2, W/2) -> (Batch, 1, H, W) (Outputs raw logits)
        self.upsample2 = nn.ConvTranspose2d(
            hidden_channels, out_channels, 
            kernel_size=4, stride=2, padding=1
        )
        # [/REFERENCE_SOLUTION]

    def forward(self, x):
        # [STUDENT_STARTER]
        # TODO: Implement the forward pass. Return raw logits (no sigmoid).
        # pass
        # [/STUDENT_STARTER]
        # [REFERENCE_SOLUTION]
        out = self.upsample1(x)
        out = self.relu(out)
        out = self.upsample2(out)
        # Interpolate to handle non-divisible resolutions (like 518)
        out = nn.functional.interpolate(out, size=(self.img_size, self.img_size), mode='bilinear', align_corners=False)
        return out
        # [/REFERENCE_SOLUTION]

def compute_hard_dice(y_pred_mask, y_true_mask, smooth=1e-6):
    """
    Computes the hard Dice Similarity Coefficient (DSC) between two binary boolean masks.
    Works on non-differentiable thresholded outputs (represented as boolean arrays).
    Formula: DSC = (2 * |A intersect B|) / (|A| + |B|)
    """
    # [STUDENT_STARTER]
    # TODO: Implement hard Dice Similarity Coefficient calculation on binary masks.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    intersection = (y_pred_mask * y_true_mask).sum()
    total = y_pred_mask.sum() + y_true_mask.sum()
    return float((2. * intersection + smooth) / (total + smooth))
    # [/REFERENCE_SOLUTION]

def compute_soft_dice(y_pred_probs, y_true_mask, smooth=1e-6):
    """
    Computes the differentiable Soft Dice Similarity Coefficient on continuous probability values.
    Sums across spatial and channel dimensions (dim=(1, 2, 3)) and averages over batch dimension.
    """
    # [STUDENT_STARTER]
    # TODO: Implement soft Dice coefficient on probabilities.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    intersection = (y_pred_probs * y_true_mask).sum(dim=(1, 2, 3))
    total = y_pred_probs.sum(dim=(1, 2, 3)) + y_true_mask.sum(dim=(1, 2, 3))
    soft_dice = (2. * intersection + smooth) / (total + smooth)
    return soft_dice.mean()
    # [/REFERENCE_SOLUTION]

def combined_loss(y_pred_logits, y_true_mask, smooth=1e-6):
    """
    Computes a combined segmentation loss: numerically stable Binary Cross Entropy (BCE) 
    with logits, plus Soft Dice Loss (1 - Soft Dice Coefficient on probabilities).
    
    Note: In practice, weights are often tuned (e.g. lambda * BCE + (1-lambda) * Dice) 
    depending on background/foreground class imbalances.
    """
    # [STUDENT_STARTER]
    # TODO: Calculate BCE pixel loss, compute Soft Dice Loss, and return sum.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    # 1. Numerically stable BCE loss w/ logits
    bce = nn.BCEWithLogitsLoss()(y_pred_logits, y_true_mask)
    
    # 2. Soft Dice Loss computed on soft sigmoid probabilities
    y_pred_probs = torch.sigmoid(y_pred_logits)
    soft_dice = compute_soft_dice(y_pred_probs, y_true_mask, smooth)
    dice_loss = 1.0 - soft_dice
    
    # Simple sum of losses
    return bce + dice_loss
    # [/REFERENCE_SOLUTION]

