import os
import unittest
import torch
from torchvision.transforms import Compose, Normalize
import target_module

class TestPreprocessingAndSplit(unittest.TestCase):
    def setUp(self):
        self.classes = {{ class_mapping | tojson }}
        self.target_size = {{ image_size }}
        self.train_split = {{ train_split }}

    def test_get_preprocess_transforms(self):
        t = target_module.get_preprocess_transforms()
        self.assertIsInstance(t, Compose)
        
        # Verify normalization layer exists and contains ImageNet values
        norm_layer = [x for x in t.transforms if isinstance(x, Normalize)]
        self.assertEqual(len(norm_layer), 1, "Should contain exactly 1 Normalize transform")
        self.assertEqual(norm_layer[0].mean, [0.485, 0.456, 0.406])
        self.assertEqual(norm_layer[0].std, [0.229, 0.224, 0.225])

    def test_split_dataset_stratified(self):
        # Generate mock image paths
        mock_paths = []
        for cls in self.classes:
            for i in range(10):
                mock_paths.append(os.path.join("dataset", cls, f"img_{i}.jpg"))
                
        train_paths, val_paths = target_module.split_dataset(mock_paths, train_ratio=self.train_split)
        
        expected_train_size = int(len(mock_paths) * self.train_split)
        expected_val_size = len(mock_paths) - expected_train_size
        
        self.assertEqual(len(train_paths), expected_train_size)
        self.assertEqual(len(val_paths), expected_val_size)
        
        # Verify stratification
        for cls in self.classes:
            cls_train = [p for p in train_paths if cls in p]
            cls_val = [p for p in val_paths if cls in p]
            self.assertEqual(len(cls_train), int(10 * self.train_split), f"Train split for {cls} is not stratified correctly")
            self.assertEqual(len(cls_val), 10 - int(10 * self.train_split), f"Val split for {cls} is not stratified correctly")

if __name__ == "__main__":
    unittest.main()
