def loop_vs_vectorization_benchmark(size=10000):
    """
    Compares the execution speed of a manual Python loop vs. NumPy vectorization:
    1. Time how long it takes to multiply every element in a list of size `size` by 2 using a Python loop.
    2. Time how long it takes to multiply every element in a NumPy array of size `size` by 2 using vectorized multiplication (*= 2).
    
    Returns: (python_loop_time, vectorized_time, speedup_ratio)
    """
    # Setup inputs
    python_list = list(range(size))
    numpy_arr = np.arange(size)
    
    # 1. Benchmark python list comprehension loop
    start = time.perf_counter()
    _ = [x * 2 for x in python_list]
    python_time = time.perf_counter() - start
    
    # 2. Benchmark vectorized multiplication
    start = time.perf_counter()
    numpy_arr *= 2
    vector_time = time.perf_counter() - start
    
    speedup = python_time / vector_time if vector_time > 0 else 1.0
    return python_time, vector_time, speedup

