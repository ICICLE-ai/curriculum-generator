def extract_patches(image, patch_size=8, stride=4):
    """
    EXTRACT PATCHES CHALLENGE (Advanced):
    Given a mock image array of shape (H, W, C), extract all square patches 
    of size patch_size x patch_size at the given stride.
    
    Returns: a NumPy array of shape (num_patches, patch_size, patch_size, C)
    """
    # [STUDENT_STARTER]
    # TODO: Extract spatial 2D patches from the image array
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    h, w, c = image.shape
    patches = []
    for y in range(0, h - patch_size + 1, stride):
        for x in range(0, w - patch_size + 1, stride):
            patch = image[y:y+patch_size, x:x+patch_size, :]
            patches.append(patch)
    return np.array(patches)
    # [/REFERENCE_SOLUTION]

