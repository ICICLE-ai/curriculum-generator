def create_and_reshape_arrays():
    """
    1. Create a 1D NumPy array containing numbers from 0 to 11 (inclusive).
    2. Reshape it into a 2D array of shape (3, 4).
    3. Create a float array of shape (2, 3) filled with zeros.
    4. Create a float array of shape (2, 3) filled with ones.
    
    Returns: (reshaped_arr, zeros_arr, ones_arr)
    """
    # [STUDENT_STARTER]
