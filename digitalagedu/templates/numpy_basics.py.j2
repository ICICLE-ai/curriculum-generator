def apply_broadcasting(image, mean_vector, mask):
    """
    Demonstrates Broadcasting:
    1. Normalize image by dividing all elements by 255.0.
    2. Subtract class mean_vector from normalized image (shape of vector matches C channel dimension).
    3. Multiply the result by a binary mask (shape H x W broadcasted across channels).
    
    Returns: processed_image
    """
    # [STUDENT_STARTER]
    # TODO: Apply broadcasting math
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    normalized = image / 255.0
    centered = normalized - mean_vector
    # Mask is shape (H, W), needs to broadcast over (H, W, C)
    # Adding a new axis for channels: mask[:, :, np.newaxis]
    if len(mask.shape) == 2:
        mask = mask[:, :, np.newaxis]
    return centered * mask
    # [/REFERENCE_SOLUTION]

def elementwise_math(arr):
    """
    Applies element-wise mathematical operations:
    1. Raise all elements to the power of 2.
    2. Add 10 to all elements.
    3. Use np.clip to restrict values to a range [0, 100].
    
    Returns: clipped_arr
    """
    # [STUDENT_STARTER]
    # TODO: Implement element-wise operations and clipping
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    squared = arr ** 2
    shifted = squared + 10
    return np.clip(shifted, 0, 100)
    # [/REFERENCE_SOLUTION]

def statistics_and_standardization(arr):
    """
    Computes statistical properties and standardizes the array (Z-score normalization).
    1. Compute mean, standard deviation, min, max, and sum of elements.
    2. Standardize array: (x - mean) / std. Return zeros if std is 0.
    
    Returns: (mean, std, min_val, max_val, sum_val, standardized_arr)
    """
    # [STUDENT_STARTER]
    # TODO: Compute statistics and perform standardization
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    mean_val = np.mean(arr)
    std_val = np.std(arr)
    min_val = np.min(arr)
    max_val = np.max(arr)
    sum_val = np.sum(arr)
    
    if std_val == 0:
        standardized_arr = np.zeros_like(arr, dtype=np.float64)
    else:
        standardized_arr = (arr - mean_val) / std_val
        
    return float(mean_val), float(std_val), float(min_val), float(max_val), float(sum_val), standardized_arr
    # [/REFERENCE_SOLUTION]

def boolean_thresholding(image, threshold=128):
    """
    Uses Boolean Masks:
    1. Create a boolean mask where image elements are strictly greater than threshold.
    2. Set all elements in the image that do not satisfy the mask to 0.
    
    Returns: thresholded_image
    """
    # [STUDENT_STARTER]
    # TODO: Use boolean masking to threshold image elements
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    mask = image > threshold
    output = image.copy()
    output[~mask] = 0
    return output
    # [/REFERENCE_SOLUTION]

def matrix_multiplication(w, x):
    """
    Performs matrix operations:
    1. Transpose matrix x.
    2. Multiply matrix w by transposed x using matrix multiplication (@).
    
    Returns: multiplied_matrix
    """
    # [STUDENT_STARTER]
    # TODO: Implement matrix transposition and matrix multiplication
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    x_t = np.transpose(x)
    return w @ x_t
    # [/REFERENCE_SOLUTION]

