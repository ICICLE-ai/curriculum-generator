def compute_euclidean_distance(vec_a, vec_b):
    """
    BONUS CHALLENGE (Advanced):
    Computes the Euclidean Distance between two 1D feature vectors.
    Unlike Cosine Similarity, Euclidean distance is highly sensitive to 
    differences in vector magnitude.
    Formula: distance = sqrt(sum((A_i - B_i)^2))
    
    Returns: distance_score (float)
    """
    # [STUDENT_STARTER]
    # TODO: Calculate euclidean distance manually
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    return float(np.linalg.norm(vec_a - vec_b))
    # [/REFERENCE_SOLUTION]
