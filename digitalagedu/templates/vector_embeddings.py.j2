def compute_euclidean_distance(vec_a, vec_b):
    """
    BONUS CHALLENGE (Advanced):
    Computes the Euclidean Distance between two 1D feature vectors.
    Unlike Cosine Similarity, Euclidean distance is highly sensitive to 
    differences in vector magnitude.
    Formula: distance = sqrt(sum((A_i - B_i)^2))
    
    Returns: distance_score (float)
    """
    # [STUDENT_STARTER]
    # TODO: Calculate euclidean distance manually
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    return float(np.linalg.norm(vec_a - vec_b))
    # [/REFERENCE_SOLUTION]

def plot_embedding_clusters(reduced_embeddings, labels, class_names, output_path):
    """
    Plots a 2D scatter plot of the PCA-reduced embeddings.
    Color-codes points by their category label to demonstrate visual clustering.
    """
    import matplotlib
    matplotlib.use('Agg')
    import matplotlib.pyplot as plt
    
    plt.figure(figsize=(8, 6))
    unique_labels = np.unique(labels)
    colors = ['tab:red', 'tab:green', 'tab:blue', 'tab:orange']
    
    for idx, label_val in enumerate(unique_labels):
        mask = (labels == label_val)
        class_name = class_names[label_val] if label_val < len(class_names) else f"Class {label_val}"
        plt.scatter(
            reduced_embeddings[mask, 0], 
            reduced_embeddings[mask, 1], 
            label=class_name,
            color=colors[idx % len(colors)],
            alpha=0.8,
            edgecolors='black',
            s=60
        )
        
    plt.title("2D PCA Projection of Image Embeddings", fontsize=12, fontweight='bold')
    plt.xlabel("Principal Component 1")
    plt.ylabel("Principal Component 2")
    plt.legend()
    plt.grid(True, linestyle="--", alpha=0.5)
    plt.tight_layout()
    plt.savefig(output_path)
    plt.close()

