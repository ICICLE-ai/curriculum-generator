def load_image_dataset(dataset_root, classes, img_size=64, max_samples=20):
    """
    Helper function to load raw dataset images dynamically, convert them to 
    RGB tensors of shape (N, 3, H, W), and output normalized features and target labels.
    """
    import os
    from PIL import Image
    import torchvision.transforms as transforms
    
    # Resolve classes format robustly (supports both lists and dicts)
    if isinstance(classes, dict):
        class_names = list(classes.values())
    else:
        class_names = list(classes)
        
    loader = transforms.Compose([
        transforms.Resize((img_size, img_size)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])
    
    x_list = []
    y_list = []
    
    for label_idx, class_name in enumerate(class_names):
        class_dir = os.path.join(dataset_root, class_name)
        if not os.path.exists(class_dir):
            continue
        
        files = [f for f in os.listdir(class_dir) if f.lower().endswith(('.png', '.jpg', '.jpeg'))]
        for f in files[:max_samples // len(class_names)]:
            img_path = os.path.join(class_dir, f)
            try:
                img_tensor = loader(Image.open(img_path).convert("RGB"))
                x_list.append(img_tensor.numpy())
                y_list.append(label_idx)
            except Exception:
                pass
                
    if len(x_list) == 0:
        # Fallback to random/mock image tensors if paths are empty
        np.random.seed(42)
        mock_x = np.random.rand(10, 3, img_size, img_size).astype(np.float32)
        mock_y = np.random.randint(0, len(class_names), size=10)
        return torch.tensor(mock_x), torch.tensor(mock_y, dtype=torch.long)
        
    return torch.tensor(np.array(x_list)), torch.tensor(np.array(y_list), dtype=torch.long)

def plot_weight_distributions(baseline_model, optimized_model, output_path):
    """
    Plots the weight distribution histograms of the first layer (conv1) 
    for both the unregularized baseline and regularized optimized models.
    """
    fig, axes = plt.subplots(1, 2, figsize=(10, 4))
    
    # Extract weights
    w_base = baseline_model.conv1.weight.detach().cpu().numpy().flatten()
    w_opt = optimized_model.conv1.weight.detach().cpu().numpy().flatten()
    
    axes[0].hist(w_base, bins=20, color='tab:red', alpha=0.7, edgecolor='black')
    axes[0].set_title("Baseline weight distribution\n(No BN / No Dropout)")
    axes[0].set_xlabel("Weight values")
    axes[0].set_ylabel("Frequency")
    axes[0].grid(True, linestyle="--", alpha=0.5)
    
    axes[1].hist(w_opt, bins=20, color='tab:green', alpha=0.7, edgecolor='black')
    axes[1].set_title("Optimized weight distribution\n(With BN + Dropout)")
    axes[1].set_xlabel("Weight values")
    axes[1].set_ylabel("Frequency")
    axes[1].grid(True, linestyle="--", alpha=0.5)
    
    plt.tight_layout()
    plt.savefig(output_path)
    plt.close()

