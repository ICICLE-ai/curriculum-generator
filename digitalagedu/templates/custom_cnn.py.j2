class CustomCNN(nn.Module):
    """
    A custom 2-stage Convolutional Neural Network:
    - Input Shape: (B, 3, img_size, img_size)
    - Conv1: 3 -> 8 channels, kernel 3, padding 1
    - Pool1: MaxPool 2x2, stride 2
    - Conv2: 8 -> 16 channels, kernel 3, padding 1
    - Pool2: MaxPool 2x2, stride 2
    - FC: Fully connected linear mapping flat features to class logits
    """
    def __init__(self, num_classes=2, img_size={{ image_size }}):
        super(CustomCNN, self).__init__()
        self.img_size = img_size
        
        # [STUDENT_STARTER]
        # TODO: Define layers inside self (conv1 -> relu -> pool -> conv2 -> fc)
        # pass
        # [/STUDENT_STARTER]
        # [REFERENCE_SOLUTION]
        self.conv1 = nn.Conv2d(in_channels=3, out_channels=8, kernel_size=3, padding=1)
        self.relu = nn.ReLU()
        self.pool = nn.MaxPool2d(kernel_size=2, stride=2)
        self.conv2 = nn.Conv2d(in_channels=8, out_channels=16, kernel_size=3, padding=1)
        
        # Compute exact linear features size after two 2x2 max poolings:
        flat_w = img_size // 4
        flat_h = img_size // 4
        self.fc = nn.Linear(16 * flat_w * flat_h, num_classes)
        # [/REFERENCE_SOLUTION]

    def forward(self, x):
        """
        Runs the forward pass through the network:
        x -> conv1 -> relu -> pool -> conv2 -> relu -> pool -> flatten -> fc
        """
        # [STUDENT_STARTER]
        # TODO: Implement forward pass.
        # pass
        # [/STUDENT_STARTER]
        # [REFERENCE_SOLUTION]
        out = self.conv1(x)
        out = self.relu(out)
        out = self.pool(out)
        
        out = self.conv2(out)
        out = self.relu(out)
        out = self.pool(out)
        
        out = out.view(out.size(0), -1)
        out = self.fc(out)
        return out
        # [/REFERENCE_SOLUTION]

def count_parameters(model):
    """
    Counts the total number of trainable weights parameters in the PyTorch model.
    """
    # [STUDENT_STARTER]
    # TODO: Calculate total trainable parameters
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    return sum(p.numel() for p in model.parameters() if p.requires_grad)
    # [/REFERENCE_SOLUTION]

def trace_cnn_shapes(model, sample_tensor):
    """
    Traces structural shape changes step-by-step as a sample moves through layers.
    
    Returns: dictionary of shapes
    """
    # [STUDENT_STARTER]
    # TODO: Record shape transitions
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    shapes = {}
    shapes["Input"] = tuple(sample_tensor.shape)
    
    if len(sample_tensor.shape) == 3:
        x = sample_tensor.unsqueeze(0)
    else:
        x = sample_tensor
        
    x1 = model.conv1(x)
    shapes["Conv1"] = tuple(x1.shape[1:])
    
    x1_r = model.relu(x1)
    x1_p = model.pool(x1_r)
    shapes["Pool1"] = tuple(x1_p.shape[1:])
    
    x2 = model.conv2(x1_p)
    shapes["Conv2"] = tuple(x2.shape[1:])
    
    x2_r = model.relu(x2)
    x2_p = model.pool(x2_r)
    shapes["Pool2"] = tuple(x2_p.shape[1:])
    
    flat = x2_p.view(x2_p.size(0), -1)
    shapes["Flatten"] = flat.shape[1]
    
    out = model.fc(flat)
    shapes["Output"] = tuple(out.shape[1:])
    
    return shapes
    # [/REFERENCE_SOLUTION]

def extract_first_layer_activations(model, image_tensor):
    """
    Extracts the feature activation maps from the first convolutional layer (conv1).
    """
    model.eval()
    with torch.no_grad():
        activations = model.conv1(image_tensor)
        return activations[0]

