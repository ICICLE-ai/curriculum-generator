def visualize_feature_maps(original_img_tensor, feature_maps, output_path):
    """
    Plots the original image in the first panel, followed by the first 7 Conv1 channels.
    Provides clear visual grounding comparing raw pixels against convolutional activations.
    """
    # [STUDENT_STARTER]
    # TODO: Plot original image alongside 7 activations in a 2x4 grid
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    # Un-normalize original image helper
    mean = np.array([0.485, 0.456, 0.406])
    std = np.array([0.229, 0.224, 0.225])
    
    orig = original_img_tensor[0].permute(1, 2, 0).cpu().numpy()
    orig = std * orig + mean
    orig = np.clip(orig, 0, 1)
    
    maps = feature_maps.cpu().numpy()
    
    fig, axes = plt.subplots(2, 4, figsize=(10, 5))
    axes_flat = axes.flatten()
    
    # Panel 0: Original Image
    axes_flat[0].imshow(orig)
    axes_flat[0].set_title("Original Image", fontsize=9, fontweight="bold")
    axes_flat[0].axis("off")
    
    # Panels 1 to 7: Conv1 Channels
    for i in range(1, 8):
        ax = axes_flat[i]
        channel_map = maps[i - 1]
        
        # Min-max normalization for visual contrast
        c_min, c_max = channel_map.min(), channel_map.max()
        if c_max > c_min:
            channel_map = (channel_map - c_min) / (c_max - c_min)
            
        ax.imshow(channel_map, cmap="viridis")
        ax.set_title(f"Filter Activation {i}", fontsize=9)
        ax.axis("off")
        
    plt.tight_layout()
    plt.savefig(output_path)
    plt.close()
    # [/REFERENCE_SOLUTION]

def softmax_predictions(logits, classes):
    """
    Applies PyTorch Softmax activation to convert raw model logits to probabilities.
    
    Returns: probabilities tensor of shape (B, num_classes)
    """
    # [STUDENT_STARTER]
    # TODO: Apply softmax on logits
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    probs = torch.softmax(logits, dim=1)
    print("\n--- MODEL DECISION INTERPRETATION ---")
    print(f"Raw Output Logits:  {logits[0].numpy()}")
    print("Mapped Probabilities:")
    for i, cls in enumerate(classes):
        percentage = probs[0, i].item() * 100
        print(f"  Class: {cls:<15} -> {percentage:.2f}%")
    return probs
    # [/REFERENCE_SOLUTION]

def compare_flatten_vs_conv():
    """
    Explains the locality conservation benefits of Convolutions vs flattening.
    """
    print("\n--- LOCALITY CONSERVATION CONCEPTS ---")
    print("Multi-Layer Perceptron (MLP):")
    print("  - Images are flattened into 1D arrays: Shape (3, 224, 224) -> (150528,)")
    print("  - This strips out all geometric relationships. The network has to relearn")
    print("    that pixel index 0 is adjacent to pixel index 1.")
    print("Convolutional Neural Network (CNN):")
    print("  - Kernel filters (e.g. 3x3 matrices) slide across the 2D height and width.")
    print("  - Neighboring pixels are processed together, preserving local structures")
    print("    like borders, corners, and circular textures.")

def explain_receptive_fields():
    """
    Simulates receptive field growth textually to show how deep layers see broader features.
    """
    print("\n--- RECEPTIVE FIELD EXPANSION MAP ---")
    print("Layer 1: Input Pixels   -> Receptive Field: 1x1  (Single pixel)")
    print("Layer 2: Conv1 (3x3)    -> Receptive Field: 3x3  (Sees immediate neighbors)")
    print("Layer 3: MaxPool1 (2x2) -> Receptive Field: 4x4  (Doubles footprint)")
    print("Layer 4: Conv2 (3x3)    -> Receptive Field: 8x8  (Grows as conv slides over pooled)")
    print("Layer 5: MaxPool2 (2x2) -> Receptive Field: 16x16")
    print("Insight: A neuron deep in the network summarizes a larger patch of the input image.")

# =====================================================================
# Conceptual Questions (CNN Operations & Receptive Fields)
# =====================================================================
# 1. Why are CNNs better than MLPs for processing images?
#    Answer: MLPs flatten images into 1D vectors, losing all spatial/geometric context
#            (e.g., whether two pixels are next to each other). CNNs apply localized
#            convolution filters that slide over the image, maintaining spatial relationships
#            and detecting localized structures (edges, textures) regardless of where they appear.
#
# 2. What is a "Receptive Field" in a deep network?
#    Answer: The receptive field is the local area of the original input image that a 
#            specific neuron "sees" or extracts features from. As we stack convolutional
#            and pooling layers deeper, the receptive field size expands, allowing deeper
#            layers to aggregate broad semantic shapes while early layers focus on tiny edges.
#
# 3. Which layer in our CustomCNN contains the most trainable parameters?
#    Answer: The Fully Connected (fc) linear layer contains the most parameters. Convolutions
#            reuse weights across all pixel regions (weight sharing), keeping parameter sizes small,
#            whereas the linear layer connects every single flat feature vector element to the outputs.

