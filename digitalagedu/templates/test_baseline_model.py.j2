import unittest
import torch
import torch.nn as nn
from torch.utils.data import TensorDataset, DataLoader
import target_module

class TestBaselineModel(unittest.TestCase):
    def setUp(self):
        self.num_classes = len({{ class_mapping | tojson }})
        self.device = torch.device("cpu")

    def test_model_fc_swap(self):
        model = target_module.get_resnet_baseline(self.num_classes)
        self.assertIsInstance(model.fc, nn.Linear)
        self.assertEqual(model.fc.out_features, self.num_classes)

    def test_training_loop(self):
        # Create a tiny mock model and dataset
        model = target_module.get_resnet_baseline(self.num_classes)
        
        # 4 mock images of shape (3, 224, 224), labels [0, 1, 0, 1] (or capped to num_classes)
        inputs = torch.randn(4, 3, 224, 224)
        targets = torch.randint(0, self.num_classes, (4,))
        
        dataset = TensorDataset(inputs, targets)
        dataloader = DataLoader(dataset, batch_size=2)
        
        optimizer = torch.optim.Adam(model.parameters(), lr=0.01)
        criterion = nn.CrossEntropyLoss()
        
        # Train for one epoch (positive verification)
        avg_loss = target_module.train_one_epoch(model, dataloader, optimizer, criterion, self.device)
        self.assertIsInstance(avg_loss, float)
        self.assertGreater(avg_loss, 0.0)

if __name__ == "__main__":
    unittest.main()
