# Injected dynamically from pipeline execution
CLASSES = {{ class_mapping | tojson }}

def calculate_metrics(predictions, ground_truths):
    """
    Computes standard performance metrics:
    1. Accuracy
    2. Precision (weighted)
    3. Recall (weighted)
    4. F1-Score (weighted)
    
    Returns a dictionary of: {metric_name: score}
    """
    # [STUDENT_STARTER]
    # TODO: Calculate accuracy, precision, recall, and f1-score.
    # Hint: Use accuracy_score and precision_recall_fscore_support from sklearn.metrics
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    acc = accuracy_score(ground_truths, predictions)
    prec, rec, f1, _ = precision_recall_fscore_support(ground_truths, predictions, average='weighted', zero_division=0)
    
    return {
        "accuracy": acc,
        "precision": prec,
        "recall": rec,
        "f1-score": f1
    }
    # [/REFERENCE_SOLUTION]

def save_confusion_matrix(predictions, ground_truths, output_path):
    """
    Generates a confusion matrix heatmap using seaborn/matplotlib 
    and saves it to output_path.
    """
    # [STUDENT_STARTER]
    # TODO: Compute confusion matrix via sklearn, plot as heatmap,
    # and save to output_path.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    cm = confusion_matrix(ground_truths, predictions, labels=CLASSES)
    
    plt.figure(figsize=(6, 5))
    sns.heatmap(cm, annot=True, fmt='d', xticklabels=CLASSES, yticklabels=CLASSES, cmap='Blues')
    plt.ylabel('Actual')
    plt.xlabel('Predicted')
    plt.title('Confusion Matrix')
    plt.tight_layout()
    plt.savefig(output_path)
    plt.close()
    # [/REFERENCE_SOLUTION]
