import os
import unittest
import numpy as np
import torch
import target_module

class TestGradioDeployment(unittest.TestCase):
    def setUp(self):
        self.classes = {{ class_mapping | tojson }}
        self.num_classes = len(self.classes)
        self.model_path = "./test_gradio_weights.pth"
        
        # Save a dummy state dictionary to load
        model = target_module.RegularizedCNN(num_classes=self.num_classes, img_size=224)
        torch.save(model.state_dict(), self.model_path)

    def tearDown(self):
        if os.path.exists(self.model_path):
            os.remove(self.model_path)

    def test_load_model_weights(self):
        # Scenario 1: Load existing weights
        model = target_module.load_model_weights(self.model_path, self.num_classes, img_size=224)
        self.assertIsInstance(model, target_module.RegularizedCNN)
        
        # Scenario 2: Handle missing file gracefully by initializing random model
        rand_model = target_module.load_model_weights("./non_existent_file.pth", self.num_classes, img_size=224)
        self.assertIsInstance(rand_model, target_module.RegularizedCNN)

    def test_run_diagnostic_pipeline(self):
        model = target_module.load_model_weights(self.model_path, self.num_classes, img_size=224)
        
        # Generate dummy 224x224 RGB image as numpy array
        dummy_image_np = np.random.randint(0, 256, (224, 224, 3), dtype=np.uint8)
        
        pred_class, conf, seg_overlay, saliency = target_module.run_pipeline(model, dummy_image_np, self.classes)
        
        self.assertIn(pred_class, self.classes)
        self.assertIsInstance(conf, float)
        self.assertTrue(0.0 <= conf <= 1.0)
        self.assertEqual(seg_overlay.shape, dummy_image_np.shape)
        self.assertEqual(saliency.shape, dummy_image_np.shape)

    def test_get_image_pixel_statistics(self):
        dummy_img = np.ones((10, 10, 3), dtype=np.uint8) * 128
        stats = target_module.get_image_pixel_statistics(dummy_img)
        self.assertEqual(stats["mean"], 128.0)
        self.assertEqual(stats["std"], 0.0)
        self.assertEqual(stats["min"], 128.0)
        self.assertEqual(stats["max"], 128.0)

if __name__ == "__main__":
    unittest.main()
