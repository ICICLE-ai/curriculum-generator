    # [/REFERENCE_SOLUTION]

def compute_autograd_gradient(x_value):
    """
    Demonstrates Autograd (Automatic Differentiation):
    1. Create a leaf scalar tensor 'x' initialized to x_value with gradient tracking enabled.
    2. Define a function y = x**2 + 3*x.
    3. Compute the gradients by running backpropagation on y.
    
    Returns: x.grad (the derivative dy/dx at x_value)
    """
    # [STUDENT_STARTER]
    # TODO: Implement scalar tensor creation and autograd backpropagation
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    x = torch.tensor(float(x_value), requires_grad=True)
    y = x**2 + 3*x
    y.backward()
    return x.grad
    # [/REFERENCE_SOLUTION]

class BreastCancerMLP(nn.Module):
    """
    A 2-layer Multi-Layer Perceptron (MLP) Classifier.
    - Input Features: input_dim
    - Hidden Layer: hidden_dim units with ReLU activation
    - Output Layer: num_classes logits
    """
    def __init__(self, input_dim=30, hidden_dim=16, num_classes=2):
        super(BreastCancerMLP, self).__init__()
        # [STUDENT_STARTER]
        # TODO: Define layers using nn.Linear and nn.ReLU
        # pass
        # [/STUDENT_STARTER]
        # [REFERENCE_SOLUTION]
        self.fc1 = nn.Linear(input_dim, hidden_dim)
        self.relu = nn.ReLU()
        self.fc2 = nn.Linear(hidden_dim, num_classes)
        # [/REFERENCE_SOLUTION]

    def forward(self, x):
        # [STUDENT_STARTER]
        # TODO: Define the forward pass
        # pass
        # [/STUDENT_STARTER]
        # [REFERENCE_SOLUTION]
        out = self.fc1(x)
        out = self.relu(out)
        out = self.fc2(out)
        return out
        # [/REFERENCE_SOLUTION]

def inspect_forward_shapes(model, x):
    """
    Traces the shape changes of a tensor as it flows through the network layers:
    1. Pass x through self.fc1, return intermediate shape.
    2. Pass through self.relu, return shape.
    3. Pass through self.fc2, return output shape.
    
    Returns: (input_shape, fc1_shape, relu_shape, output_shape)
    """
    # [STUDENT_STARTER]
    # TODO: Trace shape flow
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    input_shape = x.shape
    fc1_out = model.fc1(x)
    fc1_shape = fc1_out.shape
    relu_out = model.relu(fc1_out)
    relu_shape = relu_out.shape
    fc2_out = model.fc2(relu_out)
    output_shape = fc2_out.shape
    return input_shape, fc1_shape, relu_shape, output_shape
    # [/REFERENCE_SOLUTION]

def count_trainable_parameters(model):
    """
    Calculates the total number of trainable (learnable) parameters in the model.
    A parameter is trainable if it has requires_grad=True.
    
    Returns: int count
    """
    # [STUDENT_STARTER]
    # TODO: Sum up all trainable parameters
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    return sum(p.numel() for p in model.parameters() if p.requires_grad)
    # [/REFERENCE_SOLUTION]

