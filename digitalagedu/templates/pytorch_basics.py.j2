def tensor_basics(python_list):
    """
    1. Convert python_list into a PyTorch float tensor.
    2. Generate a random tensor of shape (3, 4) using a normal distribution.
    3. Check and return shape and dtype of both.
    4. Move the converted tensor to GPU ('cuda') if available, otherwise 'cpu'.
    
    Returns: (list_tensor, rand_tensor, list_shape, list_dtype, rand_shape, target_device)
    """
    # [STUDENT_STARTER]
    # TODO: Implement basic tensor operations
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    list_tensor = torch.tensor(python_list, dtype=torch.float32)
