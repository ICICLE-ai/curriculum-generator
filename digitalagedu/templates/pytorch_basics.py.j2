def logits_to_probabilities(logits):
    """
    Converts model raw outputs (logits) into normalized probability distributions.
    1. Apply PyTorch Softmax function along the class dimension (dim=1) to convert logits to probabilities.
    2. Find the predicted class index (highest probability class) using torch.argmax along dim=1.
    
    Returns: (probabilities_tensor, predicted_class_index_tensor)
    """
    # [STUDENT_STARTER]
    # TODO: Convert logits to softmax probabilities and argmax predictions
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    probs = torch.softmax(logits, dim=1)
    preds = torch.argmax(probs, dim=1)
    return probs, preds
    # [/REFERENCE_SOLUTION]

def train_step(model, inputs, targets, optimizer, criterion):
    """
    Runs a single training step on a batch of data:
    1. Sets the model to training mode.
    2. Clears gradients using zero_grad().
    3. Performs forward pass.
    4. Computes Cross Entropy Loss.
    5. Computes gradients using backward().
    6. Updates weights using the optimizer.
    
    Returns: float loss value
    """
    # [STUDENT_STARTER]
    # TODO: Implement a single train step.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    model.train()
    optimizer.zero_grad()
    outputs = model(inputs)
    loss = criterion(outputs, targets)
    loss.backward()
    optimizer.step()
    return loss.item()
    # [/REFERENCE_SOLUTION]

def validation_step(model, inputs, targets, criterion):
    """
    Evaluates the model on validation data without updating weights:
    1. Sets the model to evaluation mode.
    2. Disables gradient computation.
    3. Performs forward pass.
    4. Computes loss.
    5. Determines predicted class indices.
    
    Returns: float validation loss, predicted class indices (tensor)
    """
    # [STUDENT_STARTER]
    # TODO: Implement validation evaluation
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    model.eval()
    with torch.no_grad():
        outputs = model(inputs)
        loss = criterion(outputs, targets)
        preds = torch.argmax(outputs, dim=1)
    return loss.item(), preds
    # [/REFERENCE_SOLUTION]

def calculate_accuracy_manually(predictions, labels):
    """
    Manually calculates classification accuracy:
    accuracy = (correct predictions) / (total labels)
    
    predictions: Tensor of class index predictions
    labels: Tensor of actual class index labels
    
    Returns: float accuracy value
    """
    # [STUDENT_STARTER]
    # TODO: Compute accuracy using element-wise tensor comparison
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    correct = (predictions == labels).sum().item()
    total = len(labels)
    return correct / total if total > 0 else 0.0
    # [/REFERENCE_SOLUTION]

def calculate_confusion_matrix_manually(predictions, labels):
    """
    Manually calculates a binary classification confusion matrix:
    TP: True Positive (pred=1, label=1)
    FP: False Positive (pred=1, label=0)
    FN: False Negative (pred=0, label=1)
    TN: True Negative (pred=0, label=0)
    
    Returns: (tp, fp, fn, tn) as integers
    """
    # [STUDENT_STARTER]
    # TODO: Calculate TP, FP, FN, TN manually
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    tp = ((predictions == 1) & (labels == 1)).sum().item()
    fp = ((predictions == 1) & (labels == 0)).sum().item()
    fn = ((predictions == 0) & (labels == 1)).sum().item()
    tn = ((predictions == 0) & (labels == 0)).sum().item()
    return int(tp), int(fp), int(fn), int(tn)
    # [/REFERENCE_SOLUTION]

def train_model(model, train_x, train_y, val_x, val_y, epochs=10, batch_size=16, checkpoint_path="best_model.pth"):
    """
    Runs the full model training and validation loop over multiple epochs:
    1. Detects available device (CPU/GPU) and maps both the model and data tensors to it.
    2. Instantiates CrossEntropyLoss and Adam optimizer (lr=0.01).
    3. Splits training data into batches of size 'batch_size'.
    4. Tracks training and validation losses.
    5. Performs validation check at the end of each epoch, saving weights if loss improves.
    6. Prints learning statistics showing model improvements.
    
    Returns: history dictionary of train/val logs
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = model.to(device)
    
    val_x = val_x.to(device)
    val_y = val_y.to(device)
    
    criterion = nn.CrossEntropyLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=0.01)
    
    history = {"train_loss": [], "val_loss": [], "val_acc": []}
    best_val_loss = float("inf")
    
    num_samples = train_x.shape[0]
    
    for epoch in range(1, epochs + 1):
        # Shuffle training indices at the beginning of each epoch
        shuffled_indices = torch.randperm(num_samples)
        shuffled_x = train_x[shuffled_indices].to(device)
        shuffled_y = train_y[shuffled_indices].to(device)
        
        # Batch loop
        epoch_train_losses = []
        for i in range(0, num_samples, batch_size):
            batch_x = shuffled_x[i:i+batch_size]
            batch_y = shuffled_y[i:i+batch_size]
            
            loss_val = train_step(model, batch_x, batch_y, optimizer, criterion)
            epoch_train_losses.append(loss_val)
            
        mean_train_loss = np.mean(epoch_train_losses)
        
        # Validation evaluation
        mean_val_loss, val_preds = validation_step(model, val_x, val_y, criterion)
        val_acc = calculate_accuracy_manually(val_preds, val_y)
        
        # Log histories
        history["train_loss"].append(mean_train_loss)
        history["val_loss"].append(mean_val_loss)
        history["val_acc"].append(val_acc)
        
        # Checkpoint if validation loss improves
        if mean_val_loss < best_val_loss:
            best_val_loss = mean_val_loss
            torch.save(model.state_dict(), checkpoint_path)
            
        print(f"Epoch {epoch:02d}/{epochs:02d} | Train Loss: {mean_train_loss:.4f} | Val Loss: {mean_val_loss:.4f} | Val Acc: {val_acc*100:.1f}%")
        
    return history

def plot_training_curves(history, output_path):
    """
    Plots the training and validation loss curves from history dictionary.
    """
    plt.figure(figsize=(6, 4))
    epochs = range(1, len(history["train_loss"]) + 1)
    plt.plot(epochs, history["train_loss"], label='Train Loss', color='blue', marker='o')
    plt.plot(epochs, history["val_loss"], label='Val Loss', color='orange', linestyle='--', marker='s')
    plt.title('MLP Training & Validation Loss Curves')
    plt.xlabel('Epochs')
    plt.ylabel('Loss')
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.savefig(output_path)
    plt.close()

def predict_probabilities(model, inputs):
    """
    Runs model inference:
    1. Sets model to evaluation mode.
    2. Identifies the active model device and maps inputs to it.
    3. Runs forward pass under torch.no_grad() to obtain raw logits.
    4. Converts output logits to probabilities using Softmax.
    5. Computes prediction index via argmax.
    
    Returns: (predicted_class_indices, confidences)
    """
    # [STUDENT_STARTER]
    # TODO: Implement prediction inference and softmax scaling
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    model.eval()
    device = next(model.parameters()).device
    inputs = inputs.to(device)
    
    with torch.no_grad():
        logits = model(inputs)
        probs, pred_idx = logits_to_probabilities(logits)
        # Gather the probability of the predicted index
        confidences = probs[torch.arange(inputs.size(0)), pred_idx]
        
    return pred_idx.cpu(), confidences.cpu()
    # [/REFERENCE_SOLUTION]

