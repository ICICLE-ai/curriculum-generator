import os
import unittest
import torch
import torch.nn as nn
import target_module

class TestPyTorchBasics(unittest.TestCase):
    def setUp(self):
        self.classes = {{ class_mapping | tojson }}
        self.num_classes = len(self.classes)
        self.checkpoint_path = "./test_pytorch_checkpoint.pth"
        self.plot_path = "./test_pytorch_plot.png"

    def tearDown(self):
        if os.path.exists(self.checkpoint_path):
            os.remove(self.checkpoint_path)
        if os.path.exists(self.plot_path):
            os.remove(self.plot_path)

    def test_tensor_basics(self):
        python_list = [1.0, 2.0, 3.0]
        list_t, rand_t, list_sh, list_dt, rand_sh, device_t = target_module.tensor_basics(python_list)
        
        self.assertEqual(list_sh, torch.Size([3]))
        self.assertEqual(list_dt, torch.float32)
        self.assertEqual(rand_sh, torch.Size([3, 4]))
        self.assertIn(device_t, ["cpu", "cuda"])

    def test_compute_autograd_gradient(self):
        grad = target_module.compute_autograd_gradient(4.0)
        # dy/dx = 2*x + 3
        # at x=4.0: 2*4 + 3 = 11.0
        self.assertAlmostEqual(grad.item(), 11.0)

    def test_mlp_structure(self):
        model = target_module.BreastCancerMLP(input_dim=30, hidden_dim=16, num_classes=self.num_classes)
        self.assertTrue(hasattr(model, 'fc1'))
        self.assertTrue(hasattr(model, 'relu'))
        self.assertTrue(hasattr(model, 'fc2'))
        
        x = torch.randn(2, 30)
        out = model(x)
        self.assertEqual(out.shape, (2, self.num_classes))

    def test_inspect_forward_shapes(self):
        model = target_module.BreastCancerMLP(input_dim=30, hidden_dim=16, num_classes=2)
        x = torch.randn(5, 30)
        in_sh, fc_sh, rel_sh, out_sh = target_module.inspect_forward_shapes(model, x)
        self.assertEqual(in_sh, torch.Size([5, 30]))
        self.assertEqual(fc_sh, torch.Size([5, 16]))
        self.assertEqual(rel_sh, torch.Size([5, 16]))
        self.assertEqual(out_sh, torch.Size([5, 2]))

    def test_count_trainable_parameters(self):
        model = target_module.BreastCancerMLP(input_dim=30, hidden_dim=16, num_classes=2)
        params = target_module.count_trainable_parameters(model)
        # Layers:
        # fc1: weight shape (16, 30) => 480 params, bias (16) => 16 params. Total 496.
        # fc2: weight shape (2, 16) => 32 params, bias (2) => 2 params. Total 34.
        # Total MLP parameters: 496 + 34 = 530.
        self.assertEqual(params, 530)

    def test_logits_to_probabilities(self):
        logits = torch.tensor([[1.0, 3.0], [2.0, 0.0]])
        probs, preds = target_module.logits_to_probabilities(logits)
        
        # Row 1 predictions: index 1 is larger => prediction 1
        # Row 2 predictions: index 0 is larger => prediction 0
        self.assertTrue(torch.equal(preds, torch.tensor([1, 0])))
        self.assertAlmostEqual(probs[0, 0].item() + probs[0, 1].item(), 1.0, places=5)
        self.assertAlmostEqual(probs[1, 0].item() + probs[1, 1].item(), 1.0, places=5)

    def test_train_step(self):
        model = target_module.BreastCancerMLP(input_dim=30, hidden_dim=16, num_classes=self.num_classes)
        optimizer = torch.optim.Adam(model.parameters(), lr=0.01)
        criterion = nn.CrossEntropyLoss()
        
        inputs = torch.randn(4, 30)
        targets = torch.randint(0, self.num_classes, (4,))
        
        init_weights = model.fc1.weight.clone()
        loss = target_module.train_step(model, inputs, targets, optimizer, criterion)
        
        self.assertIsInstance(loss, float)
        self.assertFalse(torch.equal(model.fc1.weight, init_weights), "Weights did not update in train_step")

    def test_validation_step(self):
        model = target_module.BreastCancerMLP(input_dim=30, hidden_dim=16, num_classes=self.num_classes)
        criterion = nn.CrossEntropyLoss()
        
        inputs = torch.randn(4, 30)
        targets = torch.randint(0, self.num_classes, (4,))
        
        val_loss, preds = target_module.validation_step(model, inputs, targets, criterion)
        
        self.assertIsInstance(val_loss, float)
        self.assertEqual(preds.shape, (4,))

    def test_calculate_accuracy_manually(self):
        preds = torch.tensor([0, 1, 1, 0])
        labels = torch.tensor([0, 1, 0, 0]) # 1 mismatch (index 2)
        acc = target_module.calculate_accuracy_manually(preds, labels)
        self.assertAlmostEqual(acc, 0.75)

    def test_calculate_confusion_matrix_manually(self):
        preds = torch.tensor([1, 0, 1, 1, 0, 0])
        labels = torch.tensor([1, 1, 0, 1, 0, 0])
        # tp: pred=1, label=1 => elements 0, 3 (2)
        # fp: pred=1, label=0 => element 2 (1)
        # fn: pred=0, label=1 => element 1 (1)
        # tn: pred=0, label=0 => elements 4, 5 (2)
        tp, fp, fn, tn = target_module.calculate_confusion_matrix_manually(preds, labels)
        self.assertEqual(tp, 2)
        self.assertEqual(fp, 1)
        self.assertEqual(fn, 1)
        self.assertEqual(tn, 2)

    def test_train_model_and_predict(self):
        model = target_module.BreastCancerMLP(input_dim=30, hidden_dim=16, num_classes=self.num_classes)
        
        # Create small mock train/val datasets (e.g. 32 samples)
        train_x = torch.randn(32, 30)
        train_y = torch.randint(0, self.num_classes, (32,))
        val_x = torch.randn(16, 30)
        val_y = torch.randint(0, self.num_classes, (16,))
        
        history = target_module.train_model(
            model, train_x, train_y, val_x, val_y, 
            epochs=3, batch_size=8, checkpoint_path=self.checkpoint_path
        )
        
        self.assertEqual(len(history["train_loss"]), 3)
        self.assertEqual(len(history["val_loss"]), 3)
        self.assertEqual(len(history["val_acc"]), 3)
        
        # Verify checkpoint saved
        self.assertTrue(os.path.exists(self.checkpoint_path))
        
        # Plot curves
        target_module.plot_training_curves(history, self.plot_path)
        self.assertTrue(os.path.exists(self.plot_path))
        
        # Load weights and test predict probabilities
        model_loaded = target_module.BreastCancerMLP(input_dim=30, hidden_dim=16, num_classes=self.num_classes)
        model_loaded.load_state_dict(torch.load(self.checkpoint_path))
        
        pred_idx, confs = target_module.predict_probabilities(model_loaded, val_x)
        self.assertEqual(pred_idx.shape, (16,))
        self.assertEqual(confs.shape, (16,))
        self.assertTrue(torch.all(confs >= 0.0) and torch.all(confs <= 1.0))

if __name__ == "__main__":
    unittest.main()
