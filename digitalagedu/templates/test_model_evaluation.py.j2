import os
import unittest
import target_module

class TestModelEvaluation(unittest.TestCase):
    def setUp(self):
        self.classes = {{ class_mapping | tojson }}
        self.output_path = "./cm_test.png"

    def tearDown(self):
        if os.path.exists(self.output_path):
            os.remove(self.output_path)

    def test_calculate_metrics(self):
        # Create dummy predictions and truths matching class strings
        ground_truths = [self.classes[0]] * 5 + [self.classes[1]] * 5 if len(self.classes) >= 2 else [self.classes[0]] * 10
        predictions = [self.classes[0]] * 4 + [self.classes[1]] * 1 + [self.classes[1]] * 5 if len(self.classes) >= 2 else [self.classes[0]] * 9 + [self.classes[0]]

        metrics = target_module.calculate_metrics(predictions, ground_truths)
        
        self.assertIn("accuracy", metrics)
        self.assertIn("precision", metrics)
        self.assertIn("recall", metrics)
        self.assertIn("f1-score", metrics)
        
        if len(self.classes) >= 2:
            self.assertEqual(metrics["accuracy"], 0.9)  # 9 out of 10 correct
            self.assertGreater(metrics["precision"], 0.8)

    def test_save_confusion_matrix(self):
        ground_truths = [self.classes[0]] * 5 + [self.classes[1]] * 5 if len(self.classes) >= 2 else [self.classes[0]] * 10
        predictions = [self.classes[0]] * 5 + [self.classes[1]] * 5 if len(self.classes) >= 2 else [self.classes[0]] * 10
        
        # Ensure plot file does not pre-exist
        if os.path.exists(self.output_path):
            os.remove(self.output_path)
            
        target_module.save_confusion_matrix(predictions, ground_truths, self.output_path)
        
        # Verify heatmap image is created
        self.assertTrue(os.path.exists(self.output_path), "Confusion matrix plot was not created")

if __name__ == "__main__":
    unittest.main()
