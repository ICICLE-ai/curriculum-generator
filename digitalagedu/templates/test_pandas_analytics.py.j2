import os
import unittest
import pandas as pd
import target_module

class TestPandasAnalytics(unittest.TestCase):
    def setUp(self):
        self.csv_path = "./mock_results.csv"
        self.output_path = "./mock_plot.png"
        
        # Create a mock results CSV
        data = {
            'image_path': [f"img_{i}.jpg" for i in range(10)],
            'ground_truth': ['benign']*5 + ['malignant']*5,
            'prediction': ['benign']*4 + ['malignant']*1 + ['benign']*1 + ['malignant']*4,
            'confidence': [0.9, 0.85, 0.4, 0.95, 0.8, 0.35, 0.9, 0.95, 0.88, 0.91]
        }
        df = pd.DataFrame(data)
        df.to_csv(self.csv_path, index=False)

    def tearDown(self):
        if os.path.exists(self.csv_path):
            os.remove(self.csv_path)
        if os.path.exists(self.output_path):
            os.remove(self.output_path)

    def test_load_and_filter_results(self):
        filtered = target_module.load_and_filter_results(self.csv_path, 0.5)
        # Verify filtering removed confidence < 0.5 (rows index 2 and 5)
        self.assertEqual(len(filtered), 8)
        self.assertTrue(all(filtered['confidence'] >= 0.5))

    def test_get_accuracy_per_class(self):
        df = pd.read_csv(self.csv_path)
        accs = target_module.get_accuracy_per_class(df)
        
        # Benign: 4 correct out of 5 (80% accuracy)
        # Malignant: 4 correct out of 5 (80% accuracy)
        self.assertAlmostEqual(accs['benign'], 0.8)
        self.assertAlmostEqual(accs['malignant'], 0.8)

    def test_plot_accuracy_and_confidence(self):
        df = pd.read_csv(self.csv_path)
        target_module.plot_accuracy_and_confidence(df, self.output_path)
        
        self.assertTrue(os.path.exists(self.output_path))

if __name__ == "__main__":
    unittest.main()
