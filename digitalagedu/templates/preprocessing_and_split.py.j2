import os
import random
from PIL import Image
import torchvision.transforms as transforms

# Injected dynamically from pipeline execution
CLASSES = {{ class_mapping | tojson }}
TARGET_SIZE = {{ image_size }}

def get_preprocess_transforms():
    """
    Returns a torchvision.transforms.Compose pipeline that:
    1. Resizes images to TARGET_SIZE x TARGET_SIZE
    2. Converts them to PyTorch Tensors
    3. Normalizes them using ImageNet mean/std:
       mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]
    """
    # [STUDENT_STARTER]
    # TODO: Implement the transform pipeline using transforms.Compose
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    return transforms.Compose([
        transforms.Resize((TARGET_SIZE, TARGET_SIZE)),
        transforms.ToTensor(),
        transforms.Normalize(
            mean=[0.485, 0.456, 0.406],
            std=[0.229, 0.224, 0.225]
        )
    ])
    # [/REFERENCE_SOLUTION]

def split_dataset(image_paths, train_ratio={{ train_split }}):
    """
    Splits image_paths into train_paths and val_paths.
    Must preserve relative class ratios (stratification)!
    """
    class_groups = {cls: [] for cls in CLASSES}
    
    # Group image paths by their class folder name
    for path in image_paths:
        class_name = os.path.basename(os.path.dirname(path))
        if class_name in class_groups:
            class_groups[class_name].append(path)
            
    train_paths = []
    val_paths = []
    
    # [STUDENT_STARTER]
    # TODO: Loop through class_groups, shuffle paths (seed 42), and split
    # them using train_ratio. Append to train_paths and val_paths.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    random.seed(42)
    for class_name, paths in class_groups.items():
        random.shuffle(paths)
        split_idx = int(len(paths) * train_ratio)
        train_paths.extend(paths[:split_idx])
        val_paths.extend(paths[split_idx:])
    # [/REFERENCE_SOLUTION]
    
    return train_paths, val_paths
