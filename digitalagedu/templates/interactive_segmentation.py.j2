import cv2
import numpy as np

def inspect_image(image):
    """
    Inspects image array properties:
    1. Retrieve the shape, dtype, height, width of the image.
    2. Determine the number of color channels (default to 1 if grayscale).
    
    Returns: (shape, dtype, height, width, num_channels)
    """
    # [STUDENT_STARTER]
    # TODO: Retrieve and return basic image properties
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    shape = image.shape
    dtype = image.dtype
    height = shape[0]
    width = shape[1]
    num_channels = shape[2] if len(shape) > 2 else 1
    return shape, dtype, height, width, num_channels
    # [/REFERENCE_SOLUTION]

def convert_color_spaces(image):
    """
    Converts a BGR image into other essential color spaces:
    1. RGB (standard red-green-blue for display/matplotlib).
    2. Grayscale (single channel brightness for edge/thresholding).
    3. HSV (Hue, Saturation, Value for color-based segmentation).
    
    Returns: (rgb_img, gray_img, hsv_img)
    """
    # [STUDENT_STARTER]
    # TODO: Convert BGR input image to RGB, Grayscale, and HSV
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    rgb_img = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    gray_img = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    hsv_img = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    return rgb_img, gray_img, hsv_img
    # [/REFERENCE_SOLUTION]

def threshold_image(image, threshold_value=128):
    """
    Applies binary thresholding to a BGR or grayscale image:
    1. If the input image is color, convert it to grayscale first.
    2. Use cv2.threshold to generate a binary mask where pixels >= threshold_value 
       are set to 255 (white) and others are set to 0 (black).
       
    Returns: binary_mask
    """
    # [STUDENT_STARTER]
    # TODO: Convert to grayscale and apply binary thresholding
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    if len(image.shape) > 2 and image.shape[2] == 3:
        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    else:
        gray = image.copy()
        
    _, mask = cv2.threshold(gray, threshold_value, 255, cv2.THRESH_BINARY)
    return mask
    # [/REFERENCE_SOLUTION]

def floodfill_segmentation(image, seed_point, tolerance=10):
    """
    Applies classical seed-based floodFill segmentation:
    1. Instantiate a floodFill mask with border padding (+2 pixels wider/taller).
    2. Call cv2.floodFill on a copy of the image. newVal=255 is the mask fill color.
    3. Return the extracted inner region mask (excluding the added 2-pixel border).
    
    Returns a binary mask of shape (H, W) where target is 255 and background is 0.
    """
    # [STUDENT_STARTER]
    # TODO: Implement cv2.floodFill starting at seed_point.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    h, w = image.shape[:2]
    # FloodFill mask must be 2 pixels wider/taller than original image
    ff_mask = np.zeros((h + 2, w + 2), dtype=np.uint8)
    img_copy = image.copy()
    
    # Flags define connectivity (4) and mask fill color (255) shifted by 8 bits
    flags = 4 | (255 << 8) | cv2.FLOODFILL_MASK_ONLY
    cv2.floodFill(
        img_copy, ff_mask, seed_point, 255, 
        loDiff=(tolerance,)*3, upDiff=(tolerance,)*3, 
        flags=flags
    )
    
    # Return the inner area of the padded mask
    return ff_mask[1:-1, 1:-1]
    # [/REFERENCE_SOLUTION]

def calculate_iou(mask_a, mask_b):
    """
    Calculates the Intersection-over-Union (IoU) between two binary masks.
    """
    # [STUDENT_STARTER]
    # TODO: Implement Jaccard similarity / IoU calculation.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    bool_a = mask_a > 0
    bool_b = mask_b > 0
    
    intersection = np.logical_and(bool_a, bool_b).sum()
    union = np.logical_or(bool_a, bool_b).sum()
    
    return float(intersection / union) if union > 0 else 0.0
    # [/REFERENCE_SOLUTION]

def create_overlay(image, mask, color=(0, 255, 0), alpha=0.4):
    """
    Blends a binary mask onto the original image transparently.
    Overlay = original_image * (1 - alpha) + colored_mask * alpha
    """
    # [STUDENT_STARTER]
    # TODO: Apply cv2.addWeighted to overlay the colored mask
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    colored_mask = np.zeros_like(image)
    colored_mask[mask > 0] = color
    return cv2.addWeighted(image, 1.0 - alpha, colored_mask, alpha, 0)
    # [/REFERENCE_SOLUTION]

def find_and_draw_contours(image, mask, color=(0, 255, 255), thickness=2):
    """
    Locates contours on the binary mask and draws them on a copy of the BGR image.
    """
    # [STUDENT_STARTER]
    # TODO: Locate contours using cv2.findContours and draw them
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    img_copy = image.copy()
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    cv2.drawContours(img_copy, contours, -1, color, thickness)
    return img_copy, len(contours)
    # [/REFERENCE_SOLUTION]

def get_bounding_box(mask):
    """
    Determines the minimum bounding rectangle enclosing the mask region.
    Returns: (x, y, w, h) bounding box coordinates
    """
    # [STUDENT_STARTER]
    # TODO: Compute cv2.boundingRect coordinates
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    x, y, w, h = cv2.boundingRect(mask)
    return x, y, w, h
    # [/REFERENCE_SOLUTION]

