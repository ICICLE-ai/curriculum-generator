import os
import unittest
import torch
from PIL import Image, ImageDraw
import torchvision.transforms as transforms
import target_module

class TestCustomCNN(unittest.TestCase):
    def setUp(self):
        self.num_classes = len({{ class_mapping | tojson }})
        self.img_size = {{ image_size }}
        self.dataset_root = "{{ dataset_root }}"
        self.temp_img_path = "./mock_cnn_img.jpg"
        
        # Dual-mode dataset detection
        has_real_image = False
        if os.path.exists(self.dataset_root):
            # Find the first image file in the directory structure
            for root, dirs, files in os.walk(self.dataset_root):
                for f in files:
                    if f.lower().endswith((".jpg", ".jpeg", ".png")):
                        self.input_image_path = os.path.join(root, f)
                        has_real_image = True
                        break
                if has_real_image:
                    break

        if not has_real_image:
            # Fallback: Draw a mock binary circle on a black background
            img = Image.new("RGB", (self.img_size, self.img_size), color="black")
            draw = ImageDraw.Draw(img)
            # Draw a white circle in the center
            r = self.img_size // 4
            c = self.img_size // 2
            draw.ellipse([c-r, c-r, c+r, c+r], fill="white")
            img.save(self.temp_img_path)
            self.input_image_path = self.temp_img_path

        self.transform = transforms.Compose([
            transforms.Resize((self.img_size, self.img_size)),
            transforms.ToTensor()
        ])

    def tearDown(self):
        if os.path.exists(self.temp_img_path):
            os.remove(self.temp_img_path)

    def test_cnn_structure(self):
        model = target_module.CustomCNN(num_classes=self.num_classes, img_size=self.img_size)
        
        self.assertTrue(hasattr(model, 'conv1'))
        self.assertTrue(hasattr(model, 'conv2'))
        self.assertTrue(hasattr(model, 'pool'))
        self.assertTrue(hasattr(model, 'fc'))
        
        # Check output tensor dimensions
        x = torch.randn(2, 3, self.img_size, self.img_size)
        out = model(x)
        self.assertEqual(out.shape, (2, self.num_classes))

    def test_extract_first_layer_activations(self):
        model = target_module.CustomCNN(num_classes=self.num_classes, img_size=self.img_size)
        
        # Load and preprocess input image
        img = Image.open(self.input_image_path).convert("RGB")
        img_tensor = self.transform(img).unsqueeze(0) # (1, 3, H, W)
        
        features = target_module.extract_first_layer_activations(model, img_tensor)
        
        # Verify output matches conv1 channels and shapes
        self.assertEqual(features.shape, (8, self.img_size, self.img_size))

if __name__ == "__main__":
    unittest.main()
