import os
import unittest
import torch
import target_module

class TestCustomCNN(unittest.TestCase):
    def setUp(self):
        self.classes = {{ class_mapping | tojson }}
        self.num_classes = len(self.classes)
        self.img_size = {{ image_size }}
        self.model = target_module.CustomCNN(num_classes=self.num_classes, img_size=self.img_size)

    def test_model_architecture(self):
        self.assertTrue(hasattr(self.model, "conv1"))
        self.assertTrue(hasattr(self.model, "pool"))
        self.assertTrue(hasattr(self.model, "conv2"))
        self.assertTrue(hasattr(self.model, "fc"))
        
        dummy_input = torch.randn(2, 3, self.img_size, self.img_size)
        out = self.model(dummy_input)
        self.assertEqual(out.shape, (2, self.num_classes))

    def test_count_parameters(self):
        params = target_module.count_parameters(self.model)
        self.assertIsInstance(params, int)
        self.assertGreater(params, 0)

    def test_trace_cnn_shapes(self):
        dummy_input = torch.randn(3, self.img_size, self.img_size)
        shapes = target_module.trace_cnn_shapes(self.model, dummy_input)
        
        self.assertIn("Input", shapes)
        self.assertIn("Conv1", shapes)
        self.assertIn("Pool1", shapes)
        self.assertIn("Conv2", shapes)
        self.assertIn("Pool2", shapes)
        self.assertIn("Flatten", shapes)
        self.assertIn("Output", shapes)
        self.assertEqual(shapes["Input"], (3, self.img_size, self.img_size))
        self.assertEqual(shapes["Output"], (self.num_classes,))

    def test_extract_first_layer_activations(self):
        dummy_input = torch.randn(1, 3, self.img_size, self.img_size)
        activations = target_module.extract_first_layer_activations(self.model, dummy_input)
        self.assertEqual(activations.shape, (8, self.img_size, self.img_size))

    def test_summarize_model(self):
        target_module.summarize_model(self.model)

    def test_visualize_pooling_effect(self):
        output_grid = "./temp_pooling_comparison.png"
        if os.path.exists(output_grid):
            os.remove(output_grid)
            
        dummy_f = torch.randn(20, 20)
        dummy_p = torch.randn(10, 10)
        target_module.visualize_pooling_effect(dummy_f, dummy_p, output_grid)
        
        self.assertTrue(os.path.exists(output_grid))
        if os.path.exists(output_grid):
            os.remove(output_grid)

    def test_visualize_feature_maps(self):
        output_grid = "./temp_features_grid.png"
        if os.path.exists(output_grid):
            os.remove(output_grid)
            
        dummy_orig = torch.randn(1, 3, self.img_size, self.img_size)
        dummy_maps = torch.randn(7, self.img_size, self.img_size)
        target_module.visualize_feature_maps(dummy_orig, dummy_maps, output_grid)
        
        self.assertTrue(os.path.exists(output_grid))
        if os.path.exists(output_grid):
            os.remove(output_grid)

    def test_softmax_predictions(self):
        logits = torch.zeros((1, self.num_classes))
        if self.num_classes > 1:
            logits[0, 0] = 1.5
            logits[0, 1] = -0.5
        else:
            logits[0, 0] = 1.5
        probs = target_module.softmax_predictions(logits, self.classes)
        self.assertEqual(probs.shape, (1, self.num_classes))
        self.assertAlmostEqual(probs.sum().item(), 1.0, places=4)

    def test_conceptual_recap_functions(self):
        target_module.compare_flatten_vs_conv()
        target_module.explain_receptive_fields()

    def test_cnn_block_analysis(self):
        metrics = target_module.cnn_block_analysis(input_height=224, input_width=224)
        
        # 1. Final shape shape should be (16, 56, 56) (2 maxpools of stride 2 divide size by 4)
        self.assertEqual(metrics["final_shape"], (16, 56, 56))
        # 2. Total params: 1392
        self.assertEqual(metrics["total_parameters"], 1392)
        # 3. Memory footprint: 16 * 56 * 56 * 4 = 200704
        self.assertEqual(metrics["memory_bytes"], 200704)

if __name__ == "__main__":
    unittest.main()
