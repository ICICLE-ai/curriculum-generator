def get_resnet_model(num_classes, mode="frozen"):
    """
    Loads a ResNet18 model and sets parameter freezing configurations:
    1. "frozen": Freezes the entire convolutional backbone (feature extractor).
       Only the newly replaced fully connected head (model.fc) is trainable.
    2. "unfrozen_last_block": Freezes early layers but keeps the last convolutional block
       (model.layer4) and the fully connected head (model.fc) trainable.
       
    Returns: configurated ResNet18 model
    """
    # Use pretrained=False/weights=None to prevent cluster compute node download crashes
    model = models.resnet18(pretrained=False)
    
    # [STUDENT_STARTER]
    # TODO: Freeze weights based on target mode, swap fc head, and return.
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    if mode == "frozen":
        # Freeze ALL backbone parameters
        for param in model.parameters():
            param.requires_grad = False
            
    elif mode == "unfrozen_last_block":
        # Freeze all layers first
        for param in model.parameters():
            param.requires_grad = False
        # Unfreeze model.layer4 to fine-tune high-level visual features
        for param in model.layer4.parameters():
            param.requires_grad = True
            
    # Swap output fully connected layer
    in_features = model.fc.in_features
    model.fc = nn.Linear(in_features, num_classes)
    
    # Force FC parameters to require gradients
    for param in model.fc.parameters():
        param.requires_grad = True
        
    return model
    # [/REFERENCE_SOLUTION]

def count_trainable_parameters(model):
    """
    Counts the total number of parameters that require gradient updates.
    """
    # [STUDENT_STARTER]
    # TODO: Compute parameters count requiring gradients
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    return sum(p.numel() for p in model.parameters() if p.requires_grad)
    # [/REFERENCE_SOLUTION]

def run_10_image_comparison(model, results_csv_path, classes, transform):
    """
    Loads results.csv, samples exactly 10 images (seed 42), and runs inference
    to extract prediction classes and softmax confidence values.
    
    Returns: list of comparison dictionary metrics
    """
    # [STUDENT_STARTER]
    # TODO: Load CSV, sample 10, predict ResNet, extract confidence, and compare.
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    df = pd.read_csv(results_csv_path)
    random.seed(42)
    sample_df = df.sample(n=min(10, len(df)), random_state=42)
    
    device = torch.device("cpu")
    model.to(device)
    model.eval()
    
    comparison_results = []
    
    for _, row in sample_df.iterrows():
        img_path = row['image_path']
        gt = row['ground_truth']
        
        # Read pipeline predictions
        dino_pred_col = 'predicted_class' if 'predicted_class' in df.columns else 'prediction'
        dino_conf_col = 'confidence' if 'confidence' in df.columns else None
        
        dino_pred = row[dino_pred_col]
        dino_conf = row[dino_conf_col] if (dino_conf_col and dino_conf_col in df.columns) else 0.95
        
        resnet_pred = "Unknown"
        resnet_conf = 0.0
        
        if os.path.exists(img_path):
            try:
                img = Image.open(img_path).convert("RGB")
                img_tensor = transform(img).unsqueeze(0).to(device)
                with torch.no_grad():
                    output = model(img_tensor)
                    probs = torch.softmax(output, dim=1)
                    pred_idx = torch.argmax(probs, dim=1).item()
                    if isinstance(classes, list):
                        class_list = classes
                    elif isinstance(classes, dict):
                        if all(isinstance(k, int) or str(k).isdigit() for k in classes.keys()):
                            class_list = [classes[k] for k in sorted(classes.keys(), key=lambda x: int(x))]
                        else:
                            class_list = list(classes.keys())
                    else:
                        class_list = list(classes)
                    resnet_pred = class_list[pred_idx] if pred_idx < len(class_list) else str(pred_idx)
                    resnet_conf = probs[0, pred_idx].item()
            except Exception:
                resnet_pred = "Error"
                
        comparison_results.append({
            "image_path": img_path,
            "ground_truth": gt,
            "dinov2_prediction": dino_pred,
            "dinov2_confidence": float(dino_conf),
            "resnet_prediction": resnet_pred,
            "resnet_confidence": float(resnet_conf)
        })
        
    return comparison_results
    # [/REFERENCE_SOLUTION]

def visualize_feature_reuse(random_model_conv1, pretrained_resnet_conv1, image_tensor, output_path):
    """
    Runs the same image tensor through:
    1. A randomly initialized convolutional layer (random_model_conv1).
    2. A pre-trained ResNet18 convolutional layer (pretrained_resnet_conv1).
    Plots their first channel activations side-by-side to visually demonstrate feature reuse.
    """
    # [STUDENT_STARTER]
    # TODO: Run forward activation passes and plot side-by-side comparisons
    pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    with torch.no_grad():
        random_feats = random_model_conv1(image_tensor)[0, 0].cpu().numpy()
        pretrained_feats = pretrained_resnet_conv1(image_tensor)[0, 0].cpu().numpy()
        
    # Min-max normalization for visualization
    def norm_map(m):
        c_min, c_max = m.min(), m.max()
        return (m - c_min) / (c_max - c_min) if c_max > c_min else m
        
    random_feats = norm_map(random_feats)
    pretrained_feats = norm_map(pretrained_feats)
    
    fig, axes = plt.subplots(1, 2, figsize=(8, 4))
    
    # Panel 1: Random conv1
    axes[0].imshow(random_feats, cmap="viridis")
    axes[0].set_title("Random CNN conv1 (Unstructured Noise)")
    axes[0].axis("off")
    
    # Panel 2: Pretrained ResNet conv1
    axes[1].imshow(pretrained_feats, cmap="viridis")
    axes[1].set_title("Pretrained ResNet conv1 (Structured Edges)")
    axes[1].axis("off")
    
    plt.tight_layout()
    plt.savefig(output_path)
    plt.close()
    # [/REFERENCE_SOLUTION]

