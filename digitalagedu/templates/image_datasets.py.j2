def split_dataset(image_paths, train_ratio=0.8, seed=42):
    """
    Splits the list of image paths into training and testing partitions:
    1. Sets random seed for reproducible splits.
    2. Shuffles the paths list.
    3. Splits using the train_ratio index boundary.
    
    Returns: (train_paths, test_paths)
    """
    # [STUDENT_STARTER]
    # TODO: Shuffle and split dataset paths
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    random.seed(seed)
    paths_copy = list(image_paths)
    random.shuffle(paths_copy)
    
    split_idx = int(len(paths_copy) * train_ratio)
    train_paths = paths_copy[:split_idx]
    test_paths = paths_copy[split_idx:]
    
    return train_paths, test_paths
    # [/REFERENCE_SOLUTION]

class CustomImageDataset(Dataset):
    """
    A custom PyTorch Dataset that scans directory structure,
    maps subfolders to integer class labels, and loads raw images.
    """
    def __init__(self, image_paths, classes, transform=None):
        self.image_paths = image_paths
        self.classes = classes
        self.transform = transform
        
        # Create mapping dictionary: {class_name: label_index}
        # [STUDENT_STARTER]
        # TODO: Define label mapping
        # pass
        # [/STUDENT_STARTER]
        # [REFERENCE_SOLUTION]
        self.class_to_idx = {cls: idx for idx, cls in enumerate(classes)}
        # [/REFERENCE_SOLUTION]

    def __len__(self):
        # [STUDENT_STARTER]
        # TODO: Return total number of samples
        # pass
        # [/STUDENT_STARTER]
        # [REFERENCE_SOLUTION]
        return len(self.image_paths)
        # [/REFERENCE_SOLUTION]

    def __getitem__(self, idx):
        """
        Loads the image at the specified index, maps its parent folder name 
        to an integer class label, applies transforms, and returns (tensor, label).
        """
        # [STUDENT_STARTER]
        # TODO: Open PIL Image as RGB, identify class label, apply transform
        # pass
        # [/STUDENT_STARTER]
        # [REFERENCE_SOLUTION]
        img_path = self.image_paths[idx]
        image = Image.open(img_path).convert("RGB")
        
        # Determine class directory name from parent directory
        class_name = os.path.basename(os.path.dirname(img_path))
        label = self.class_to_idx[class_name]
        
        if self.transform:
            image = self.transform(image)
            
        return image, label
        # [/REFERENCE_SOLUTION]

