def build_transforms(img_size={{ image_size }}):
    """
    Defines a required preprocessing transform pipeline for validation/testing:
    1. Resize image to (img_size, img_size).
    2. Convert to PyTorch Tensor.
    3. Normalize using standard ImageNet mean/std values.
       
    Returns: transforms.Compose pipeline
    """
    # [STUDENT_STARTER]
    # TODO: Create Compose preprocessing transform pipeline
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    return transforms.Compose([
        transforms.Resize((img_size, img_size)),
        transforms.ToTensor(),
        transforms.Normalize(
            mean=[0.485, 0.456, 0.406],
            std=[0.229, 0.224, 0.225]
        )
    ])
    # [/REFERENCE_SOLUTION]

def build_augmentation_transforms(img_size={{ image_size }}):
    """
    Defines an optional data augmentation transform pipeline for training:
    1. Resize image.
    2. Apply RandomHorizontalFlip.
    3. Apply RandomRotation of 10 degrees.
    4. Convert to PyTorch Tensor.
    5. Normalize.
    
    Returns: transforms.Compose pipeline
    """
    # [STUDENT_STARTER]
    # TODO: Create Compose training data augmentation pipeline
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    return transforms.Compose([
        transforms.Resize((img_size, img_size)),
        transforms.RandomHorizontalFlip(p=0.5),
        transforms.RandomRotation(degrees=10),
        transforms.ToTensor(),
        transforms.Normalize(
            mean=[0.485, 0.456, 0.406],
            std=[0.229, 0.224, 0.225]
        )
    ])
    # [/REFERENCE_SOLUTION]

def inspect_transform_flow(image_path, transform, img_size={{ image_size }}):
    """
    Traces structural changes as a raw image moves through the preprocessing pipeline:
    1. Load image using PIL.
    2. Convert PIL dimensions to (H, W, C) numpy representation.
    3. Check shape after Resize.
    4. Check shape/dtype after ToTensor.
    5. Check shape after normalization.
    
    Returns: (orig_shape, resized_shape, tensor_shape, norm_shape)
    """
    # [STUDENT_STARTER]
    # TODO: Trace shape transformations
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    pil_img = Image.open(image_path).convert("RGB")
    orig_shape = (pil_img.height, pil_img.width, 3)
    
    resized_pil = pil_img.resize((img_size, img_size))
    resized_shape = (resized_pil.height, resized_pil.width, 3)
    
    to_tensor = transforms.ToTensor()
    tensor_img = to_tensor(resized_pil)
    tensor_shape = tensor_img.shape
    
    norm_img = transform(pil_img)
    norm_shape = norm_img.shape
    
    return orig_shape, resized_shape, tensor_shape, norm_shape
    # [/REFERENCE_SOLUTION]

