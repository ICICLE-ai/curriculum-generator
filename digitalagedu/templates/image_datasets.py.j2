def calculate_dataset_statistics(image_paths, classes):
    """
    Computes class counts and identifies dataset class imbalances.
    
    Returns: (class_counts_dict, largest_class_name, smallest_class_name)
    """
    # [STUDENT_STARTER]
    # TODO: Calculate folder counts and locate extremes
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    class_counts = {cls: 0 for cls in classes}
    for path in image_paths:
        cls_name = os.path.basename(os.path.dirname(path))
        if cls_name in class_counts:
            class_counts[cls_name] += 1
            
    largest_class = max(class_counts, key=class_counts.get)
    smallest_class = min(class_counts, key=class_counts.get)
    
    return class_counts, largest_class, smallest_class
    # [/REFERENCE_SOLUTION]

def validate_batch(batch_images, batch_labels, num_classes):
    """
    Performs critical sanity checks on a dataloader batch:
    1. Checks if images contain NaN values.
    2. Verifies images tensor has 4 dimensions (B, C, H, W).
    3. Verifies images tensor has dtype float32.
    4. Verifies labels are within range [0, num_classes - 1].
    
    Returns: (no_nans_bool, shape_valid_bool, dtype_valid_bool, range_valid_bool)
    """
    # [STUDENT_STARTER]
    # TODO: Implement sanity checks on batch data
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    no_nans = not torch.isnan(batch_images).any().item()
    shape_valid = len(batch_images.shape) == 4
    dtype_valid = batch_images.dtype == torch.float32
    range_valid = (batch_labels >= 0).all().item() and (batch_labels < num_classes).all().item()
    
    return no_nans, shape_valid, dtype_valid, range_valid
    # [/REFERENCE_SOLUTION]

def visualize_batch(batch_images, batch_labels, classes, output_path):
    """
    Visualizes a batch of images:
    1. Clips and un-normalizes tensors back to [0.0, 1.0] range.
    2. Plots up to 16 images in a 4x4 subplots layout.
    3. Labels each subplot with its actual text class category name.
    """
    # [STUDENT_STARTER]
    # TODO: Build un-normalization and grid plot visualizer with text labels
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    mean = np.array([0.485, 0.456, 0.406])
    std = np.array([0.229, 0.224, 0.225])
    
    batch_size = min(batch_images.shape[0], 16)
    
    fig, axes = plt.subplots(4, 4, figsize=(8, 8))
    axes_flat = axes.flatten()
    
    for i in range(16):
        ax = axes_flat[i]
        if i < batch_size:
            # CHW -> HWC
            img_tensor = batch_images[i].permute(1, 2, 0).numpy()
            img_tensor = std * img_tensor + mean
            img_tensor = np.clip(img_tensor, 0, 1)
            
            ax.imshow(img_tensor)
            label_idx = batch_labels[i].item()
            label_name = classes[label_idx]
            ax.set_title(label_name, fontsize=10)
        ax.axis('off')
        
    plt.tight_layout()
    plt.savefig(output_path)
    plt.close()
    # [/REFERENCE_SOLUTION]

def compare_shuffle_effect(dataset, batch_size=4):
    """
    Demonstrates the difference in sequential vs. shuffled batches:
    1. Pull the labels of the first 2 batches with shuffle=False.
    2. Pull the labels of the first 2 batches with shuffle=True.
    
    Returns: (unshuffled_labels_list, shuffled_labels_list)
    """
    # [STUDENT_STARTER]
    # TODO: Extract label sequences to compare shuffling
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    loader_no = DataLoader(dataset, batch_size=batch_size, shuffle=False)
    loader_yes = DataLoader(dataset, batch_size=batch_size, shuffle=True)
    
    unshuffled = []
    for x, y in loader_no:
        unshuffled.extend(y.tolist())
        if len(unshuffled) >= batch_size * 2:
            break
            
    shuffled = []
    for x, y in loader_yes:
        shuffled.extend(y.tolist())
        if len(shuffled) >= batch_size * 2:
            break
            
    return unshuffled[:batch_size * 2], shuffled[:batch_size * 2]
    # [/REFERENCE_SOLUTION]

# =====================================================================
# Conceptual Questions (DataLoader & Systems Pacing)
# =====================================================================
# 1. Why doesn't PyTorch load every dataset image into RAM at startup?
#    Answer: Real-world image datasets contain thousands or millions of large images,
#            which easily exceed system RAM (often 50GB+). PyTorch uses a lazy loading
#            approach: it only opens and processes images on-the-fly when a specific 
#            batch is requested, keeping memory consumption low.
#
# 2. What is the role of shuffle=True in DataLoader?
#    Answer: Shuffling randomly reorders samples at the start of each epoch. If we
#            don't shuffle, the model might memorize order biases or get stuck updating
#            weights on consecutive batches of the same class, causing poor convergence.
#
# 3. Why must transforms sometimes differ between train and validation/test datasets?
#    Answer: Training datasets use data augmentation (Random flips, rotations, color shifts)
#            to artificially expand the dataset size and make the model robust to variations.
#            Validation and testing datasets must NEVER use random modifications, as we
#            need deterministic, unmodified images to measure the model's true performance.

