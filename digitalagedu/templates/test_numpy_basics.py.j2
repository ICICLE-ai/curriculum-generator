import unittest
import numpy as np
import target_module

class TestNumPyBasics(unittest.TestCase):
    def test_create_and_reshape_arrays(self):
        reshaped_arr, zeros_arr, ones_arr = target_module.create_and_reshape_arrays()
        self.assertEqual(reshaped_arr.shape, (3, 4))
        self.assertTrue(np.array_equal(reshaped_arr, np.arange(12).reshape(3, 4)))
        self.assertEqual(zeros_arr.shape, (2, 3))
        self.assertTrue(np.all(zeros_arr == 0.0))
        self.assertEqual(ones_arr.shape, (2, 3))
        self.assertTrue(np.all(ones_arr == 1.0))

    def test_slice_and_crop(self):
        # Image shape H=50, W=100, C=3
        mock_image = np.arange(50 * 100 * 3).reshape(50, 100, 3)
        cropped = target_module.slice_and_crop(mock_image)
        # Expected crop size: rows 20 to 40 (21 elements), cols 50 to 80 (31 elements), channels 3
        self.assertEqual(cropped.shape, (21, 31, 3))
        self.assertTrue(np.array_equal(cropped, mock_image[20:41, 50:81, :]))

    def test_apply_broadcasting(self):
        # 10x10 RGB image
        img = np.ones((10, 10, 3)) * 255.0
        mean_vector = np.array([0.5, 0.2, 0.1])
        mask = np.ones((10, 10))
        mask[5:, :] = 0.0 # Bottom half masked out
        
        processed = target_module.apply_broadcasting(img, mean_vector, mask)
        
        # Expected: normalized = 1.0. centered = 1.0 - mean_vector = [0.5, 0.8, 0.9]
        # In bottom half, mask is 0 so values should be 0.
        self.assertEqual(processed.shape, (10, 10, 3))
        self.assertAlmostEqual(processed[0, 0, 0], 0.5)
        self.assertAlmostEqual(processed[0, 0, 1], 0.8)
        self.assertAlmostEqual(processed[0, 0, 2], 0.9)
        self.assertAlmostEqual(processed[6, 0, 0], 0.0)

    def test_elementwise_math(self):
        arr = np.array([1.0, 5.0, 10.0])
        result = target_module.elementwise_math(arr)
        
        # Output should be (arr**2) + 10 clipped to [0, 100]
        # 1**2 + 10 = 11
        # 5**2 + 10 = 35
        # 10**2 + 10 = 110 (clipped to 100)
        self.assertTrue(np.array_equal(result, np.array([11.0, 35.0, 100.0])))

    def test_statistics_and_standardization(self):
        arr = np.array([[1.0, 2.0], [3.0, 4.0]])
        mean, std, min_val, max_val, sum_val, standardized = target_module.statistics_and_standardization(arr)
        
        self.assertAlmostEqual(mean, 2.5)
        self.assertAlmostEqual(std, np.std(arr))
        self.assertEqual(min_val, 1.0)
        self.assertEqual(max_val, 4.0)
        self.assertEqual(sum_val, 10.0)
        self.assertAlmostEqual(np.mean(standardized), 0.0)
        self.assertAlmostEqual(np.std(standardized), 1.0)

    def test_boolean_thresholding(self):
        img = np.array([[100, 150], [80, 200]])
        thresholded = target_module.boolean_thresholding(img, threshold=120)
        
        # Elements > 120 are kept, others set to 0
        expected = np.array([[0, 150], [0, 200]])
        self.assertTrue(np.array_equal(thresholded, expected))

    def test_matrix_multiplication(self):
        # matrix w shape (2, 3)
        w = np.array([[1, 2, 3], [4, 5, 6]])
        # matrix x shape (2, 3), transpose x shape (3, 2)
        x = np.array([[1, 0, 1], [0, 1, 0]])
        
        result = target_module.matrix_multiplication(w, x)
        self.assertEqual(result.shape, (2, 2))
        
        # Expected = w @ x.T
        # [[1,2,3], [4,5,6]] @ [[1,0], [0,1], [1,0]]
        # Row 1 Col 1: 1*1 + 2*0 + 3*1 = 4
        # Row 1 Col 2: 1*0 + 2*1 + 3*0 = 2
        # Row 2 Col 1: 4*1 + 5*0 + 6*1 = 10
        # Row 2 Col 2: 4*0 + 5*1 + 6*0 = 5
        expected = np.array([[4, 2], [10, 5]])
        self.assertTrue(np.array_equal(result, expected))

    def test_random_generation(self):
        f_arr, i_arr = target_module.random_generation(seed=42)
        
        self.assertEqual(f_arr.shape, (3, 3))
        self.assertTrue(np.all(f_arr >= 0.0) and np.all(f_arr < 1.0))
        self.assertEqual(i_arr.shape, (3, 3))
        self.assertTrue(np.all(i_arr >= 1) and np.all(i_arr <= 10))

    def test_loop_vs_vectorization_benchmark(self):
        python_time, vector_time, speedup = target_module.loop_vs_vectorization_benchmark(size=100)
        self.assertIsInstance(python_time, float)
        self.assertIsInstance(vector_time, float)
        self.assertIsInstance(speedup, float)

    def test_extract_patches(self):
        # Image shape (16, 16, 3)
        img = np.arange(16 * 16 * 3).reshape(16, 16, 3)
        patches = target_module.extract_patches(img, patch_size=8, stride=4)
        
        # Grid sizes: (16 - 8) / 4 + 1 = 3 patches along each dimension => 9 patches total
        self.assertEqual(patches.shape, (9, 8, 8, 3))
        # Check first patch pixels matches top left image crop
        self.assertTrue(np.array_equal(patches[0], img[0:8, 0:8, :]))

    def test_load_image_as_array(self):
        # Test loading valid raw image path
        raw_img = target_module.load_image_as_array(r"{{ sample_image_path }}")
        self.assertIsInstance(raw_img, np.ndarray)
        self.assertEqual(len(raw_img.shape), 3) # raw RGB mock image should have 3 channels (H, W, C)
        
        # Test loading invalid path raises FileNotFoundError
        with self.assertRaises(FileNotFoundError):
            target_module.load_image_as_array("non_existent_image_path.jpg")

if __name__ == "__main__":
    unittest.main()
