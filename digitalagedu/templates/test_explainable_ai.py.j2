import unittest
import numpy as np
import torch
import torch.nn as nn
import target_module

# Create a mock model containing conv2 and a linear head for testing
class MockModel(nn.Module):
    def __init__(self):
        super(MockModel, self).__init__()
        self.conv1 = nn.Conv2d(3, 4, kernel_size=3, padding=1)
        self.conv2 = nn.Conv2d(4, 8, kernel_size=3, padding=1)
        self.fc = nn.Linear(8 * 10 * 10, 2)
        
    def forward(self, x):
        out = self.conv1(x)
        out = self.conv2(out)
        out = out.view(out.size(0), -1)
        out = self.fc(out)
        return out

class TestExplainableAI(unittest.TestCase):
    def test_generate_gradcam(self):
        model = MockModel()
        image_tensor = torch.randn(1, 3, 10, 10, requires_grad=True)
        
        cam = target_module.generate_gradcam(model, image_tensor, target_class_idx=1)
        
        # Verify shape matches conv2 output feature dimensions (10x10 spatial shape)
        self.assertEqual(cam.shape, (10, 10))
        self.assertTrue(np.all(cam >= 0.0))
        self.assertTrue(np.all(cam <= 1.0))

    def test_generate_saliency_map(self):
        model = MockModel()
        image_tensor = torch.randn(1, 3, 10, 10, requires_grad=True)
        saliency = target_module.generate_saliency_map(model, image_tensor, target_class_idx=1)
        self.assertEqual(saliency.shape, (10, 10))

    def test_postprocess_heatmap(self):
        cam = np.zeros((5, 5))
        cam[2, 2] = 1.0 # center high value
        
        smoothed, binarized = target_module.postprocess_heatmap(cam, threshold=0.1)
        self.assertEqual(smoothed.shape, (5, 5))
        # Center should be smoothed down to 1/9 ~ 0.111
        self.assertAlmostEqual(smoothed[2, 2], 1/9, places=4)
        # Threshold at 0.1 should keep it active
        self.assertEqual(binarized[2, 2], 1.0)

    def test_compute_heatmap_overlap(self):
        h1 = np.ones((10, 10)) * 0.8
        h2 = np.ones((10, 10)) * 0.8
        # Perfect overlap
        iou = target_module.compute_heatmap_overlap(h1, h2, threshold=0.5)
        self.assertEqual(iou, 1.0)
        
        h2[0:5, :] = 0.2  # 50% mismatch
        iou_half = target_module.compute_heatmap_overlap(h1, h2, threshold=0.5)
        self.assertAlmostEqual(iou_half, 0.5, places=4)

    def test_class_switch_stability(self):
        model = MockModel()
        image_tensor = torch.randn(1, 3, 10, 10, requires_grad=True)
        res = target_module.test_class_switch_stability(model, image_tensor, class_a_idx=0, class_b_idx=1)
        
        self.assertEqual(res["cam_a"].shape, (10, 10))
        self.assertEqual(res["cam_b"].shape, (10, 10))
        self.assertTrue(0.0 <= res["overlap_iou"] <= 1.0)
        
        # Verify heatmaps are not class-insensitive or cheated with static arrays
        self.assertFalse(np.array_equal(res["cam_a"], res["cam_b"]), "Grad-CAM heatmaps for Class A and B must not be identical")
        self.assertTrue(np.any(res["cam_a"] > 0.0), "Heatmap must not be completely zero")
        self.assertTrue(np.any(res["cam_a"] < 1.0), "Heatmap must not be completely flat ones")

if __name__ == "__main__":
    unittest.main()
