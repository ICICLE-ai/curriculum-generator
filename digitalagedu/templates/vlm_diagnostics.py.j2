# CONCEPTUAL SHIFT (From Reports -> Dialogic Collaboration):
# - Why is Visual Question Answering (VQA) more powerful than static reports?
#   * A report is a one-way dump of information.
#   * VQA allows interactive dialogic search: users ask specific follow-up questions
#     about local shapes, artifacts, margins, or features of the target image.
#
# CHAT TEMPLATE SEQUENCING:
# - VLMs process dialogue as a list of dict messages with "role" (user/assistant) 
#   and structured content fields indicating text blocks vs image references.
# - Keeping track of previous turns (chat history) is critical so the model remembers
#   what it said earlier (e.g. "Where is the border we discussed?").
#
# SAFETY GUARDRAILS & ATTRIBUTION AUDITS:
# - Generative VLMs can hallucinate or make confident diagnostic errors.
#   In clinical or high-stakes industrial domains, we must audit responses for 
#   mandatory safety disclaimers and expert referrals before displaying text to users.
# =====================================================================

def format_chat_message(user_query, image_path=None, chat_history=None):
    """
    Formats the user's question, optional image path, and previous chat history 
    into a standardized chat template format expected by Vision-Language Models (VLMs).
    
    Structure of each message:
    {
      "role": "user" | "assistant",
      "content": [
         {"type": "text", "text": "..."}
         # Optionally {"type": "image", "image": "path/to/image"}
      ]
    }
    """
    # [STUDENT_STARTER]
    # TODO: Build standard list of chat message dictionaries.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    messages = []
    if chat_history is not None:
        for role, text in chat_history:
            messages.append({
                "role": role,
                "content": [{"type": "text", "text": text}]
            })
            
    content = [{"type": "text", "text": user_query}]
    if image_path is not None:
        content.append({"type": "image", "image": image_path})
        
    messages.append({
        "role": "user",
        "content": content
    })
    return messages
    # [/REFERENCE_SOLUTION]

def parse_vqa_response(response_text):
    """
    Parses VLM natural language responses to verify safety compliance.
    Checks if a safety medical/scientific disclaimer is present, and if it directs
    the user to a professional consultant.
    
    Returns a dictionary:
    {
      "response": str,
      "disclaimer_present": bool,
      "suggests_professional": bool
    }
    """
    # [STUDENT_STARTER]
    # TODO: Check for disclaimers and next-step professional advice keywords.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    lower_text = response_text.lower()
    disclaimer_keywords = ["disclaimer", "not professional advice", "not a doctor", "not a diagnostician", "medical disclaimer"]
    professional_keywords = ["consult a professional", "consult a doctor", "seek professional", "consult a dermatologist", "expert advice", "biopsy"]
    
    has_disclaimer = any(kw in lower_text for kw in disclaimer_keywords)
    has_prof_advice = any(kw in lower_text for kw in professional_keywords)
    
    return {
        "response": response_text.strip(),
        "disclaimer_present": has_disclaimer,
        "suggests_professional": has_prof_advice
    }
    # [/REFERENCE_SOLUTION]

def extract_metrics_from_chat(chat_text):
    """
    Uses regular expressions to extract class category predictions and confidence scores
    that the VLM might have naturally conversationalized in its text response.
    
    Example: "The image indicates class benign with a 89.2% probability."
    Returns: (class_name_str, confidence_float)
    """
    # [STUDENT_STARTER]
    # TODO: Extract predicted class and confidence score float via regex.
    # pass
    # [/STUDENT_STARTER]
    # [REFERENCE_SOLUTION]
    import re
    class_match = re.search(r'class\s+([a-zA-Z_]+)', chat_text, re.IGNORECASE)
    conf_match = re.search(r'(\d+\.?\d*)\s*%', chat_text)
    
    cls = class_match.group(1) if class_match else "unknown"
    conf = float(conf_match.group(1)) / 100.0 if conf_match else 0.0
    return cls, conf
    # [/REFERENCE_SOLUTION]

