import os
import unittest
import numpy as np
import torch
import torchvision.transforms as transforms
from PIL import Image
import target_module

class TestImageDatasets(unittest.TestCase):
    def setUp(self):
        self.classes = {{ class_mapping | tojson }}
        self.num_classes = len(self.classes)
        self.temp_img_dir = "./temp_mock_dataset"
        self.temp_paths = []
        
        # Create a mock dataset directory structure
        os.makedirs(self.temp_img_dir, exist_ok=True)
        for cls in self.classes:
            cls_dir = os.path.join(self.temp_img_dir, cls)
            os.makedirs(cls_dir, exist_ok=True)
            
            # Save 5 dummy black PNG images in each class folder (total 10 images)
            for i in range(5):
                img_path = os.path.join(cls_dir, f"img_{i}.png")
                img = Image.new("RGB", (10, 10), color="black")
                img.save(img_path)
                self.temp_paths.append(img_path)

    def tearDown(self):
        import shutil
        if os.path.exists(self.temp_img_dir):
            shutil.rmtree(self.temp_img_dir, ignore_errors=True)

    def test_split_dataset(self):
        train, test = target_module.split_dataset(self.temp_paths, train_ratio=0.6, seed=42)
        # 10 * 0.6 = 6 train, 4 test
        self.assertEqual(len(train), 6)
        self.assertEqual(len(test), 4)
        self.assertEqual(len(set(train).intersection(set(test))), 0)

    def test_dataset_len_and_getitem(self):
        transform = transforms.ToTensor()
        dataset = target_module.CustomImageDataset(self.temp_paths, self.classes, transform)
        
        self.assertEqual(len(dataset), len(self.temp_paths))
        img_tensor, label = dataset[0]
        self.assertTrue(torch.is_tensor(img_tensor))
        self.assertEqual(img_tensor.shape, (3, 10, 10))
        self.assertIsInstance(label, int)
        
        # Test class label mappings (first 5 benign/class 0, next 5 malignant/class 1)
        _, label_class_0 = dataset[0]
        _, label_class_1 = dataset[5]
        self.assertEqual(label_class_0, 0)
        self.assertEqual(label_class_1, 1)

    def test_inspect_dataset(self):
        transform = transforms.ToTensor()
        dataset = target_module.CustomImageDataset(self.temp_paths, self.classes, transform)
        d_len, s_shape, s_lbl = target_module.inspect_dataset(dataset)
        
        self.assertEqual(d_len, len(self.temp_paths))
        self.assertEqual(s_shape, torch.Size([3, 10, 10]))
        self.assertIsInstance(s_lbl, int)

    def test_build_transforms(self):
        tf = target_module.build_transforms(img_size=20)
        self.assertIsInstance(tf, transforms.Compose)
        pil_img = Image.new("RGB", (30, 30), color="white")
        out = tf(pil_img)
        self.assertEqual(out.shape, (3, 20, 20))

    def test_build_augmentation_transforms(self):
        tf = target_module.build_augmentation_transforms(img_size=20)
        self.assertIsInstance(tf, transforms.Compose)
        pil_img = Image.new("RGB", (30, 30), color="white")
        out = tf(pil_img)
        self.assertEqual(out.shape, (3, 20, 20))

    def test_inspect_transform_flow(self):
        tf = target_module.build_transforms(img_size=20)
        orig_s, res_s, ten_s, norm_s = target_module.inspect_transform_flow(self.temp_paths[0], tf, img_size=20)
        
        self.assertEqual(orig_s, (10, 10, 3))
        self.assertEqual(res_s, (20, 20, 3))
        self.assertEqual(ten_s, torch.Size([3, 20, 20]))
        self.assertEqual(norm_s, torch.Size([3, 20, 20]))

    def test_explain_pipeline_shapes(self):
        target_module.explain_pipeline_shapes()

    def test_calculate_dataset_statistics(self):
        counts, largest, smallest = target_module.calculate_dataset_statistics(self.temp_paths, self.classes)
        self.assertEqual(len(counts), self.num_classes)
        for cls in self.classes:
            self.assertEqual(counts[cls], 5)

    def test_validate_batch(self):
        batch_images = torch.randn(4, 3, 224, 224)
        batch_labels = torch.tensor([0, 1, 0, 1])
        no_nans, sh_ok, dt_ok, rg_ok = target_module.validate_batch(batch_images, batch_labels, num_classes=self.num_classes)
        self.assertTrue(no_nans)
        self.assertTrue(sh_ok)
        self.assertTrue(dt_ok)
        self.assertTrue(rg_ok)

    def test_visualize_batch(self):
        output_grid = "./temp_test_grid.png"
        if os.path.exists(output_grid):
            os.remove(output_grid)
            
        batch_images = torch.randn(4, 3, 10, 10)
        batch_labels = torch.tensor([0, 1, 0, 0])
        target_module.visualize_batch(batch_images, batch_labels, self.classes, output_grid)
        
        self.assertTrue(os.path.exists(output_grid))
        if os.path.exists(output_grid):
            os.remove(output_grid)

    def test_compare_shuffle_effect(self):
        transform = transforms.ToTensor()
        dataset = target_module.CustomImageDataset(self.temp_paths, self.classes, transform)
        unshuffled, shuffled = target_module.compare_shuffle_effect(dataset, batch_size=2)
        self.assertEqual(len(unshuffled), 4)
        self.assertEqual(len(shuffled), 4)

    def test_calculate_dataset_stats(self):
        transform = transforms.ToTensor()
        dataset = target_module.CustomImageDataset(self.temp_paths, self.classes, transform)
        mean, std = target_module.calculate_dataset_stats(dataset, max_samples=4)
        self.assertEqual(mean.shape, (3,))
        self.assertEqual(std.shape, (3,))

if __name__ == "__main__":
    unittest.main()
