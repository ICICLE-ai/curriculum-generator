{
    "tenant": "icicleai",
    "id": "smart-curriculum-designer",
    "version": "1.0.0",
    "description": "AI Curriculum Pipeline",
    "jobType": "BATCH",
    "runtime": "SINGULARITY",
    "runtimeOptions": [
        "SINGULARITY_RUN"
    ],
    "containerImage": "docker://jassehxia/digital-age-edu:latest",
    "jobAttributes": {
        "description": "Run the AI pipeline using a provided YAML configuration.",
        "execSystemId": "expanse-tapis-static",
        "execSystemExecDir": "/jobs/${JobUUID}",
        "execSystemInputDir": "/jobs/${JobUUID}",
        "execSystemOutputDir": "/jobs/${JobUUID}/outputs",
        "execSystemLogicalQueue": "tapisGPUshared",
        "nodeCount": 1,
        "coresPerNode": 12,
        "memoryMB": 64000,
        "maxMinutes": 300,
        "parameterSet": {
            "appArgs": [
                {
                    "name": "config_file",
                    "description": "The value should be the absolute path to your YAML configuration file.",
                    "inputMode": "REQUIRED"
                }
            ],
            "schedulerOptions": [
                {
                    "name": "resource-allocation",
                    "description": "Project account or allocation ID for scheduler billing (e.g., -A <project_id>)",
                    "arg": "-A uot260",
                    "inputMode": "REQUIRED"
                },
                {
                    "name": "gpu-request",
                    "description": "Number of GPUs requested from scheduler",
                    "arg": "--gpus=1",
                    "inputMode": "REQUIRED"
                },
                {
                    "name": "singularity-cache-export",
                    "description": "Export node /tmp cache environment variables to host Slurm job environment",
                    "arg": "--export=ALL,SINGULARITY_CACHEDIR=/expanse/lustre/scratch/harvest/temp_project/.cache/singularity/cache,SINGULARITY_TMPDIR=/expanse/lustre/scratch/harvest/temp_project/.cache/singularity/cache/oci-tmp,APPTAINER_CACHEDIR=/expanse/lustre/scratch/harvest/temp_project/.cache/singularity/cache,APPTAINER_TMPDIR=/expanse/lustre/scratch/harvest/temp_project/.cache/singularity/cache/oci-tmp",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                }
            ],
            "containerArgs": [
                {
                    "name": "bind-gpu",
                    "description": "Bind NVIDIA drivers to the Singularity container",
                    "arg": "--nv",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                },
                {
                    "name": "bind-expanse",
                    "description": "Bind Expanse Lustre scratch storage into Singularity container",
                    "arg": "--bind /expanse:/expanse",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                }
            ],
            "envVariables": [
                {
                    "key": "TAPIS_REFRESH_TOKEN",
                    "description": "Tapis Refresh Token required to authenticate with ICICLE Qdrant vector database",
                    "inputMode": "REQUIRED"
                },
                {
                    "key": "TRITON_CACHE_DIR",
                    "value": "/expanse/lustre/scratch/harvest/temp_project/.cache/triton",
                    "description": "Redirect Triton JIT cache away from home directory to scratch",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                },
                {
                    "key": "TORCH_EXTENSIONS_DIR",
                    "value": "/expanse/lustre/scratch/harvest/temp_project/.cache/torch_extensions",
                    "description": "Redirect PyTorch C++ extensions cache away from home directory to scratch",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                },
                {
                    "key": "VLLM_CACHE_ROOT",
                    "value": "/expanse/lustre/scratch/harvest/temp_project/.cache/vllm",
                    "description": "Redirect vLLM model cache away from home directory to scratch",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                },
                {
                    "key": "HF_HOME",
                    "value": "/expanse/lustre/scratch/harvest/temp_project/.cache/huggingface",
                    "description": "Redirect HuggingFace model cache away from home directory to scratch",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                },
                {
                    "key": "XDG_CACHE_HOME",
                    "value": "/expanse/lustre/scratch/harvest/temp_project/.cache",
                    "description": "Redirect general cache away from home directory to scratch",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                },
                {
                    "key": "MPLCONFIGDIR",
                    "value": "/expanse/lustre/scratch/harvest/temp_project/.cache/matplotlib",
                    "description": "Redirect Matplotlib font/config cache away from home directory to scratch",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                },
                {
                    "key": "WANDB_DIR",
                    "value": "/expanse/lustre/scratch/harvest/temp_project/.cache/wandb",
                    "description": "Redirect Weights & Biases telemetry to scratch",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                },
                {
                    "key": "WANDB_CACHE_DIR",
                    "value": "/expanse/lustre/scratch/harvest/temp_project/.cache/wandb",
                    "description": "Redirect Weights & Biases cache to scratch",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                },
                {
                    "key": "VLLM_NO_USAGE_STATS",
                    "value": "1",
                    "description": "Disable vLLM usage reporting writes to ~/.config/vllm",
                    "inputMode": "INCLUDE_BY_DEFAULT"
                }
            ]
        }
    }
}