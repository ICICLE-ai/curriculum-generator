{
    "id": "digital-age-edu",
    "version": "1.0.8",
    "description": "AI Curriculum Pipeline",
    "jobType": "BATCH",
    "runtime": "SINGULARITY",
    "runtimeOptions": [
        "SINGULARITY_RUN"
    ],
    "containerImage": "docker://jassehxia/digital-age-edu:latest",
    "jobAttributes": {
        "description": "Run the AI pipeline using a provided YAML configuration.",
        "execSystemId": "ascend-static",
        "execSystemExecDir": "./digitalagedu-outputs/${JobUUID}",
        "execSystemLogicalQueue": "nextgen",
        "memoryMB": 64000,
        "parameterSet": {
            "appArgs": [
                {
                    "name": "config_file",
                    "description": "Absolute path to your YAML configuration file (e.g. /fs/ess/PAS2699/sample_config.yaml).",
                    "inputMode": "REQUIRED"
                }
            ]
        }
    }
}