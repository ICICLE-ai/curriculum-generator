{
    "tenant": "icicleai",
    "id": "smart-curriculum-designer",
    "version": "1.0.0",
    "description": "AI Curriculum Pipeline",
    "jobType": "BATCH",
    "runtime": "SINGULARITY",
    "runtimeOptions": [
        "SINGULARITY_RUN"
    ],
    "containerImage": "docker://jassehxia/digital-age-edu@sha256:492f442dbe78328c6fbf061d4c0ad67f909cd07d75dec78ae89ea989e05d6696",
    "jobAttributes": {
        "description": "Run the AI pipeline using a provided YAML configuration.",
        "execSystemId": "expanse-tapis-static",
        "execSystemExecDir": "/jobs/${JobUUID}",
        "execSystemInputDir": "/jobs/${JobUUID}",
        "execSystemOutputDir": "/jobs/${JobUUID}/outputs",
        "execSystemLogicalQueue": "tapisGPUshared",
        "nodeCount": 1,
        "coresPerNode": 12,
        "memoryMB": 64000,
        "maxMinutes": 300,
        "parameterSet": {
            "appArgs": [
                {
                    "name": "config_file",
                    "description": "Absolute path to your YAML configuration file.",
                    "inputMode": "REQUIRED"
                }
            ],
            "schedulerOptions": [
                {
                    "name": "resource-allocation",
                    "description": "Project account or allocation ID for scheduler billing (e.g., -A <project_id>)",
                    "arg": "-A uot260",
                    "inputMode": "REQUIRED"
                },
                {
                    "name": "gpu-request",
                    "description": "Number of GPUs requested from scheduler",
                    "arg": "--gpus=1",
                    "inputMode": "REQUIRED"
                }
            ],
            "containerArgs": [
                {
                    "name": "bind-gpu",
                    "description": "Bind NVIDIA drivers to the Singularity container",
                    "arg": "--nv",
                    "inputMode": "FIXED"
                }
            ]
        }
    }
}